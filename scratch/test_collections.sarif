fn main() -> I32 effects [alloc, io] {
    let m = map_new();
    let mut m_entries = m.entries;
    let mut m_len = m.len;
    
    let m1 = map_insert(Map { entries: m_entries, len: m_len }, "hello", 123);
    m_entries = m1.entries;
    m_len = m1.len;
    
    let m2 = map_insert(Map { entries: m_entries, len: m_len }, "world", 456);
    m_entries = m2.entries;
    m_len = m2.len;
    
    let m3 = map_insert(Map { entries: m_entries, len: m_len }, "hello", 789);
    m_entries = m3.entries;
    m_len = m3.len;
    
    let g1 = map_get(Map { entries: m_entries, len: m_len }, "hello");
    m_entries = g1.map.entries;
    m_len = g1.map.len;
    
    let g2 = map_get(Map { entries: m_entries, len: m_len }, "world");
    m_entries = g2.map.entries;
    m_len = g2.map.len;
    
    let g3 = map_get(Map { entries: m_entries, len: m_len }, "missing");
    m_entries = g3.map.entries;
    m_len = g3.map.len;
    
    if not g1.present or g1.value != 789 {
        stdout_write("fail hello\n");
    };
    if not g2.present or g2.value != 456 {
        stdout_write("fail world\n");
    };
    if g3.present {
        stdout_write("fail missing\n");
    };
    
    let m4 = map_remove(Map { entries: m_entries, len: m_len }, "hello");
    m_entries = m4.entries;
    m_len = m4.len;
    
    let g4 = map_get(Map { entries: m_entries, len: m_len }, "hello");
    m_entries = g4.map.entries;
    m_len = g4.map.len;
    
    if g4.present {
        stdout_write("fail hello removed\n");
    };
    
    let s = set_new();
    let mut s_entries = s.entries;
    let mut s_len = s.len;
    
    let s1 = set_insert(Set { entries: s_entries, len: s_len }, "apple");
    s_entries = s1.entries;
    s_len = s1.len;
    
    let s2 = set_insert(Set { entries: s_entries, len: s_len }, "banana");
    s_entries = s2.entries;
    s_len = s2.len;
    
    let sc1 = set_contains(Set { entries: s_entries, len: s_len }, "apple");
    s_entries = sc1.set.entries;
    s_len = sc1.set.len;
    
    let sc2 = set_contains(Set { entries: s_entries, len: s_len }, "banana");
    s_entries = sc2.set.entries;
    s_len = sc2.set.len;
    
    let sc3 = set_contains(Set { entries: s_entries, len: s_len }, "cherry");
    s_entries = sc3.set.entries;
    s_len = sc3.set.len;
    
    if not sc1.present {
        stdout_write("fail apple set\n");
    };
    if not sc2.present {
        stdout_write("fail banana set\n");
    };
    if sc3.present {
        stdout_write("fail cherry set\n");
    };
    
    let s3 = set_remove(Set { entries: s_entries, len: s_len }, "apple");
    s_entries = s3.entries;
    s_len = s3.len;
    
    let sc4 = set_contains(Set { entries: s_entries, len: s_len }, "apple");
    s_entries = sc4.set.entries;
    s_len = sc4.set.len;
    
    if sc4.present {
        stdout_write("fail apple removed set\n");
    };
    
    let final_map = Map { entries: m_entries, len: m_len };
    let final_set = Set { entries: s_entries, len: s_len };
    
    stdout_write("all tests passed\n");
    0
}
