                                                            HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: OptionalHirDiag { present: true, diag: d }, d15: list.d15, d16: list.d16 }
                                                        } else {
                                                            if list.len == 14 {
                                                                HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: OptionalHirDiag { present: true, diag: d }, d16: list.d16 }
                                                            } else {
                                                                if list.len == 15 {
                                                                    HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: list.d15, d16: OptionalHirDiag { present: true, diag: d } }
                                                                } else {
                                                                    list
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn hir_optional_diag_false() -> OptionalHirDiag {
    OptionalHirDiag { present: false, diag: HirLoweringDiag { kind: HirLoweringDiagKind.Generic, msg: "" } }
}

fn hir_module_new() -> HirModuleData {
    HirModuleData { consts: hir_const_list_new(), funcs: hir_fn_list_2_new(), enums: hir_enum_list_new(), structs: hir_struct_list_new(), exprs: hir_expr_pool_new(), bodies: hir_body_pool_new() }
}

fn hir_module_lower(report: ModuleReport) -> HirLowering {
    let module = if report.ok {
        hir_build_module_from_outline(report.outline, report.fn_outline, report.events, "")
    } else {
        hir_module_new()
    };
    hir_module_to_lowering(module)
}

fn hir_lower_top_level(source: Text) -> HirLowering {
    let report = parse_module_report(source);
    let module = hir_module_from_report(report, source);
    hir_module_to_lowering(module)
}

fn hir_module_from_report(report: ModuleReport, source: Text) -> HirModuleData {
    if not report.ok {
        hir_module_new()
    } else {
        let module = hir_build_module_from_outline(report.outline, report.fn_outline, report.events, source);
        let enriched_funcs = hir_enrich_fn_list(module.funcs, report.fn_outline, source);
        let enriched_structs = hir_enrich_structs_from_outline(module.structs, report.outline, source);
        let enriched_enums = hir_enrich_enums_from_outline(module.enums, report.outline, source);
        HirModuleData { consts: module.consts, funcs: enriched_funcs, enums: enriched_enums, structs: enriched_structs, exprs: module.exprs, bodies: module.bodies }
    }
}

fn hir_span_text(span: Span, source: Text) -> Text {
    if span.start < span.end and span.end <= text_len(source) {
        text_slice(source, span.start, span.end)
    } else {
        ""
    }
}

fn hir_name_from_span(span: OptionalSpan, source: Text) -> Text {
    if span.present {
        hir_span_text(span.span, source)
    } else {
        ""
    }
}

fn hir_build_module_from_outline(outline: TopLevelOutline, fn_outline: FnOutline, events: EventStream, source: Text) -> HirModuleData {
    let e1 = top_level_entry_at(outline, 0);
    let e2 = top_level_entry_at(outline, 1);
    let e3 = top_level_entry_at(outline, 2);
    let e4 = top_level_entry_at(outline, 3);
    let e5 = top_level_entry_at(outline, 4);
    let n1 = hir_name_from_span(e1.entry.name_span, source);
    let n2 = hir_name_from_span(e2.entry.name_span, source);
    let n3 = hir_name_from_span(e3.entry.name_span, source);
    let n4 = hir_name_from_span(e4.entry.name_span, source);
    let n5 = hir_name_from_span(e5.entry.name_span, source);
    let c1 = if e1.present and e1.entry.kind == TopLevelKind.Const { hir_const_list_with(hir_const_new(n1)) } else { hir_const_list_new() };
    let c2 = if e2.present and e2.entry.kind == TopLevelKind.Const { hir_const_list_push(c1, hir_const_new(n2)) } else { c1 };
    let c3 = if e3.present and e3.entry.kind == TopLevelKind.Const { hir_const_list_push(c2, hir_const_new(n3)) } else { c2 };
    let c4 = if e4.present and e4.entry.kind == TopLevelKind.Const { hir_const_list_push(c3, hir_const_new(n4)) } else { c3 };
    let c5 = if e5.present and e5.entry.kind == TopLevelKind.Const { hir_const_list_push(c4, hir_const_new(n5)) } else { c4 };
    let f1 = if e1.present and e1.entry.kind == TopLevelKind.Fn { hir_fn_list_2_with(hir_fn_new(n1)) } else { hir_fn_list_2_new() };
    let f2 = if e2.present and e2.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f1, hir_fn_new(n2)) } else { f1 };
    let f3 = if e3.present and e3.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f2, hir_fn_new(n3)) } else { f2 };
    let f4 = if e4.present and e4.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f3, hir_fn_new(n4)) } else { f3 };
    let f5 = if e5.present and e5.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f4, hir_fn_new(n5)) } else { f4 };
    let en1 = if e1.present and e1.entry.kind == TopLevelKind.Enum { hir_enum_list_with(hir_enum_new(n1)) } else { hir_enum_list_new() };
    let en2 = if e2.present and e2.entry.kind == TopLevelKind.Enum { hir_enum_list_push(en1, hir_enum_new(n2)) } else { en1 };
    let en3 = if e3.present and e3.entry.kind == TopLevelKind.Enum { hir_enum_list_push(en2, hir_enum_new(n3)) } else { en2 };
    let en4 = if e4.present and e4.entry.kind == TopLevelKind.Enum { hir_enum_list_push(en3, hir_enum_new(n4)) } else { en3 };
    let en5 = if e5.present and e5.entry.kind == TopLevelKind.Enum { hir_enum_list_push(en4, hir_enum_new(n5)) } else { en4 };
    let s1 = if e1.present and e1.entry.kind == TopLevelKind.Struct { hir_struct_list_with(hir_struct_new(n1)) } else { hir_struct_list_new() };
    let s2 = if e2.present and e2.entry.kind == TopLevelKind.Struct { hir_struct_list_push(s1, hir_struct_new(n2)) } else { s1 };
    let s3 = if e3.present and e3.entry.kind == TopLevelKind.Struct { hir_struct_list_push(s2, hir_struct_new(n3)) } else { s2 };
    let s4 = if e4.present and e4.entry.kind == TopLevelKind.Struct { hir_struct_list_push(s3, hir_struct_new(n4)) } else { s3 };
    let s5 = if e5.present and e5.entry.kind == TopLevelKind.Struct { hir_struct_list_push(s4, hir_struct_new(n5)) } else { s4 };
    HirModuleData { consts: c5, funcs: f5, enums: en5, structs: s5, exprs: hir_expr_pool_new(), bodies: hir_body_pool_new() }
}



fn hir_parse_type_ref_from_name(name: Text) -> HirTypeRef {
    if name == "I32" { hir_type_ref_i32() }
    else if name == "F64" { hir_type_ref_f64() }
    else if name == "Bool" { hir_type_ref_bool() }
    else if name == "Text" { hir_type_ref_text() }
    else if name == "Unit" { hir_type_ref_unit() }
    else if text_len(name) >= 6 and text_eq_range(name, 0, 6, "Array[") {
        let inner_end = text_len(name) - 1;
        if inner_end > 6 {
            let elem = text_slice(name, 6, inner_end);
            hir_type_ref_array(elem)
        } else { hir_type_ref_named(name) }
    }
    else if text_len(name) >= 10 and text_eq_range(name, 0, 10, "Optional[") {
        let inner_end = text_len(name) - 1;
        if inner_end > 10 {
            let inner = text_slice(name, 10, inner_end);
            hir_type_ref_optional(inner)
        } else { hir_type_ref_named(name) }
    }
    else { hir_type_ref_named(name) }
}

fn hir_is_ws(b: I32) -> Bool { b == 32 or b == 9 or b == 10 or b == 13 }

fn hir_trim_text(text: Text) -> Text {
    let len = text_len(text);
    if len == 0 { "" }
    else {
        let mut start = 0;
        let mut keep_going = true;
        while start < len and keep_going {
            if hir_is_ws(text_byte(text, start)) { start = start + 1; }
            else { keep_going = false; };
        };
        if start == len { "" }
        else {
            let mut end = len;
            keep_going = true;
            while end > start and keep_going {
                if hir_is_ws(text_byte(text, end - 1)) { end = end - 1; }
                else { keep_going = false; };
            };
            text_slice(text, start, end)
        }
    }
}

fn hir_parse_param_from_slice(text: Text, start: I32, end: I32) -> OptionalHirParam {
    if start >= end {
        hir_optional_param_false()
    } else {
        let colon = text_find_byte_range(text, start, end, 58);
        if colon == -1 or colon >= end {
            let name = hir_trim_text(text_slice(text, start, end));
            if is_empty_text(name) {
                hir_optional_param_false()
            } else {
                OptionalHirParam { present: true, param: HirParam { name: name, ty: hir_type_ref_unit() } }
            }
        } else {
            let name = hir_trim_text(text_slice(text, start, colon));
            let ty_name = hir_trim_text(text_slice(text, colon + 1, end));
            if is_empty_text(name) {
                hir_optional_param_false()
            } else {
                let ty = hir_parse_type_ref_from_name(ty_name);
                OptionalHirParam { present: true, param: HirParam { name: name, ty: ty } }
            }
        }
    }
}

fn hir_find_comma_inner(text: Text, start: I32, end: I32) -> I32 {
    text_find_byte_range(text, start, end, 44)
}

fn hir_extract_param_list_from_source(source: Text, span_start: I32, span_end: I32) -> HirParamList {
    let raw = text_slice(source, span_start, span_end);
    let raw_len = text_len(raw);
    if raw_len < 2 { hir_param_list_new() }
    else {
        let inner = text_slice(raw, 1, raw_len - 1);
        let inner_len = text_len(inner);
        let c1 = text_find_byte_range(inner, 0, inner_len, 44);
        let p1_end = if c1 == -1 { inner_len } else { c1 };
        let p1 = hir_parse_param_from_slice(inner, 0, p1_end);
        let p2_start = if c1 == -1 { inner_len } else { c1 + 1 };
        let c2 = text_find_byte_range(inner, p2_start, inner_len, 44);
        let p2_end = if c2 == -1 { inner_len } else { c2 };
        let p2 = if p2_start < inner_len { hir_parse_param_from_slice(inner, p2_start, p2_end) } else { hir_optional_param_false() };
        let p3_start = if c2 == -1 { inner_len } else { c2 + 1 };
        let c3 = text_find_byte_range(inner, p3_start, inner_len, 44);
        let p3_end = if c3 == -1 { inner_len } else { c3 };
        let p3 = if p3_start < inner_len { hir_parse_param_from_slice(inner, p3_start, p3_end) } else { hir_optional_param_false() };
        let p4_start = if c3 == -1 { inner_len } else { c3 + 1 };
        let c4 = text_find_byte_range(inner, p4_start, inner_len, 44);
        let p4_end = if c4 == -1 { inner_len } else { c4 };
        let p4 = if p4_start < inner_len { hir_parse_param_from_slice(inner, p4_start, p4_end) } else { hir_optional_param_false() };
        let p5_start = if c4 == -1 { inner_len } else { c4 + 1 };
        let c5 = text_find_byte_range(inner, p5_start, inner_len, 44);
        let p5_end = if c5 == -1 { inner_len } else { c5 };
        let p5 = if p5_start < inner_len { hir_parse_param_from_slice(inner, p5_start, p5_end) } else { hir_optional_param_false() };
        let p6_start = if c5 == -1 { inner_len } else { c5 + 1 };
        let c6 = text_find_byte_range(inner, p6_start, inner_len, 44);
        let p6_end = if c6 == -1 { inner_len } else { c6 };
        let p6 = if p6_start < inner_len { hir_parse_param_from_slice(inner, p6_start, p6_end) } else { hir_optional_param_false() };
        let p7_start = if c6 == -1 { inner_len } else { c6 + 1 };
        let c7 = text_find_byte_range(inner, p7_start, inner_len, 44);
        let p7_end = if c7 == -1 { inner_len } else { c7 };
        let p7 = if p7_start < inner_len { hir_parse_param_from_slice(inner, p7_start, p7_end) } else { hir_optional_param_false() };
        let p8_start = if c7 == -1 { inner_len } else { c7 + 1 };
        let c8 = text_find_byte_range(inner, p8_start, inner_len, 44);
        let p8_end = if c8 == -1 { inner_len } else { c8 };
        let p8 = if p8_start < inner_len { hir_parse_param_from_slice(inner, p8_start, p8_end) } else { hir_optional_param_false() };
        let p9_start = if c8 == -1 { inner_len } else { c8 + 1 };
        let c9 = text_find_byte_range(inner, p9_start, inner_len, 44);
        let p9_end = if c9 == -1 { inner_len } else { c9 };
        let p9 = if p9_start < inner_len { hir_parse_param_from_slice(inner, p9_start, p9_end) } else { hir_optional_param_false() };
        let p10_start = if c9 == -1 { inner_len } else { c9 + 1 };
        let c10 = text_find_byte_range(inner, p10_start, inner_len, 44);
        let p10_end = if c10 == -1 { inner_len } else { c10 };
        let p10 = if p10_start < inner_len { hir_parse_param_from_slice(inner, p10_start, p10_end) } else { hir_optional_param_false() };
        let p11_start = if c10 == -1 { inner_len } else { c10 + 1 };
        let c11 = text_find_byte_range(inner, p11_start, inner_len, 44);
        let p11_end = if c11 == -1 { inner_len } else { c11 };
        let p11 = if p11_start < inner_len { hir_parse_param_from_slice(inner, p11_start, p11_end) } else { hir_optional_param_false() };
        let p12_start = if c11 == -1 { inner_len } else { c11 + 1 };
        let c12 = text_find_byte_range(inner, p12_start, inner_len, 44);
        let p12_end = if c12 == -1 { inner_len } else { c12 };
        let p12 = if p12_start < inner_len { hir_parse_param_from_slice(inner, p12_start, p12_end) } else { hir_optional_param_false() };
        let p13_start = if c12 == -1 { inner_len } else { c12 + 1 };
        let c13 = text_find_byte_range(inner, p13_start, inner_len, 44);
        let p13_end = if c13 == -1 { inner_len } else { c13 };
        let p13 = if p13_start < inner_len { hir_parse_param_from_slice(inner, p13_start, p13_end) } else { hir_optional_param_false() };
        let p14_start = if c13 == -1 { inner_len } else { c13 + 1 };
        let c14 = text_find_byte_range(inner, p14_start, inner_len, 44);
        let p14_end = if c14 == -1 { inner_len } else { c14 };
        let p14 = if p14_start < inner_len { hir_parse_param_from_slice(inner, p14_start, p14_end) } else { hir_optional_param_false() };
        let p15_start = if c14 == -1 { inner_len } else { c14 + 1 };
        let c15 = text_find_byte_range(inner, p15_start, inner_len, 44);
        let p15_end = if c15 == -1 { inner_len } else { c15 };
        let p15 = if p15_start < inner_len { hir_parse_param_from_slice(inner, p15_start, p15_end) } else { hir_optional_param_false() };
        let p16_start = if c15 == -1 { inner_len } else { c15 + 1 };
        let p16 = if p16_start < inner_len { hir_parse_param_from_slice(inner, p16_start, inner_len) } else { hir_optional_param_false() };
        let count = (if p1.present { 1 } else { 0 }) + (if p2.present { 1 } else { 0 }) + (if p3.present { 1 } else { 0 }) + (if p4.present { 1 } else { 0 }) + (if p5.present { 1 } else { 0 }) + (if p6.present { 1 } else { 0 }) + (if p7.present { 1 } else { 0 }) + (if p8.present { 1 } else { 0 }) + (if p9.present { 1 } else { 0 }) + (if p10.present { 1 } else { 0 }) + (if p11.present { 1 } else { 0 }) + (if p12.present { 1 } else { 0 }) + (if p13.present { 1 } else { 0 }) + (if p14.present { 1 } else { 0 }) + (if p15.present { 1 } else { 0 }) + (if p16.present { 1 } else { 0 });
        HirParamList { len: count, p1: p1, p2: p2, p3: p3, p4: p4, p5: p5, p6: p6, p7: p7, p8: p8, p9: p9, p10: p10, p11: p11, p12: p12, p13: p13, p14: p14, p15: p15, p16: p16 }
    }
}

fn hir_strip_return_arrow(text: Text) -> Text {
    let len = text_len(text);
    if len >= 2 and text_byte(text, 0) == 45 and text_byte(text, 1) == 62 {
        let mut start = 2;
        let mut go = true;
        while start < len and go {
            if hir_is_ws(text_byte(text, start)) { start = start + 1; }
            else { go = false; };
        };
        if start >= len { "" }
        else { text_slice(text, start, len) }
    } else { text }
}

fn hir_enrich_single_fn(f: HirFn, shape: FnHeaderShape, source: Text) -> HirFn {
    let f_with_params = if shape.params_span.present {
        hir_fn_set_params(f, hir_extract_param_list_from_source(source, shape.params_span.span.start, shape.params_span.span.end))
    } else { f };
    let f_final = if shape.return_span.present {
        let ret_text = hir_strip_return_arrow(hir_trim_text(hir_span_text(shape.return_span.span, source)));
        if not is_empty_text(ret_text) {
            let ty = hir_parse_type_ref_from_name(ret_text);
            hir_fn_set_ret(f_with_params, hir_optional_type_ref_true(ty))
        } else { f_with_params }
    } else { f_with_params };
    f_final
}

fn hir_enrich_fn_list(list: HirFnList2, fn_outline: FnOutline, source: Text) -> HirFnList2 {
    let mut fn_idx = 0;
    let f1_opt = list.f1;
    let f1_new = if f1_opt.present {
        if fn_outline_entry_at(fn_outline, fn_idx).present {
            let shape = fn_outline_entry_at(fn_outline, fn_idx).entry.shape;
            let enriched = hir_enrich_single_fn(f1_opt.f, shape, source);
            OptionalHirFn2 { present: true, f: enriched }
        } else { f1_opt }
    } else { f1_opt };
    if f1_opt.present { fn_idx = fn_idx + 1; };
    let f2_opt = list.f2;
    let f2_new = if f2_opt.present {
        if fn_outline_entry_at(fn_outline, fn_idx).present {
            let shape = fn_outline_entry_at(fn_outline, fn_idx).entry.shape;
            let enriched = hir_enrich_single_fn(f2_opt.f, shape, source);
            OptionalHirFn2 { present: true, f: enriched }
        } else { f2_opt }
    } else { f2_opt };
    if f2_opt.present { fn_idx = fn_idx + 1; };
    let f3_opt = list.f3;
    let f3_new = if f3_opt.present {
        if fn_outline_entry_at(fn_outline, fn_idx).present {
            let shape = fn_outline_entry_at(fn_outline, fn_idx).entry.shape;
            let enriched = hir_enrich_single_fn(f3_opt.f, shape, source);
            OptionalHirFn2 { present: true, f: enriched }
        } else { f3_opt }
    } else { f3_opt };
    if f3_opt.present { fn_idx = fn_idx + 1; };
    let f4_opt = list.f4;
    let f4_new = if f4_opt.present {
        if fn_outline_entry_at(fn_outline, fn_idx).present {
            let shape = fn_outline_entry_at(fn_outline, fn_idx).entry.shape;
            let enriched = hir_enrich_single_fn(f4_opt.f, shape, source);
            OptionalHirFn2 { present: true, f: enriched }
        } else { f4_opt }
    } else { f4_opt };
    if f4_opt.present { fn_idx = fn_idx + 1; };
    let f5_opt = list.f5;
    let f5_new = if f5_opt.present {
        if fn_outline_entry_at(fn_outline, fn_idx).present {
            let shape = fn_outline_entry_at(fn_outline, fn_idx).entry.shape;
            let enriched = hir_enrich_single_fn(f5_opt.f, shape, source);
            OptionalHirFn2 { present: true, f: enriched }
        } else { f5_opt }
    } else { f5_opt };
    HirFnList2 { len: list.len, f1: f1_new, f2: f2_new, f3: f3_new, f4: f4_new, f5: f5_new, f6: list.f6, f7: list.f7, f8: list.f8, f9: list.f9, f10: list.f10, f11: list.f11, f12: list.f12, f13: list.f13, f14: list.f14, f15: list.f15, f16: list.f16 }
}

fn hir_enrich_struct_payload(s: HirStruct, fields: HirFieldList) -> HirStruct {
    HirStruct { name: s.name, fields: fields, span: s.span }
}

fn hir_enrich_enum_payload(e: HirEnum, variants: HirVariantList) -> HirEnum {
    HirEnum { name: e.name, variants: variants, span: e.span }
}

fn hir_find_open_brace(text: Text, start: I32, end: I32) -> I32 {
    text_find_byte_range(text, start, end, 123)
}

fn hir_find_close_brace(text: Text, start: I32, end: I32) -> I32 {
    text_find_byte_range(text, start, end, 125)
}

fn hir_find_open_paren(text: Text, start: I32, end: I32) -> I32 {
    text_find_byte_range(text, start, end, 40)
}

fn hir_find_close_paren(text: Text, start: I32, end: I32) -> I32 {
    text_find_byte_range(text, start, end, 41)
}

fn hir_parse_field_from_slice(text: Text, start: I32, end: I32) -> OptionalHirField {
    let trimmed = hir_trim_text(text_slice(text, start, end));
    if is_empty_text(trimmed) {
        hir_optional_field_false()
    } else {
        let colon = text_find_byte_range(trimmed, 0, text_len(trimmed), 58);
        if colon == -1 or colon >= text_len(trimmed) {
            let name = hir_trim_text(trimmed);
            if is_empty_text(name) { hir_optional_field_false() }
            else { OptionalHirField { present: true, field: HirField { name: name, ty: hir_type_ref_unit(), span: hir_span_new(0, 0) } } }
        } else {
            let name = hir_trim_text(text_slice(trimmed, 0, colon));
            let ty_name = hir_trim_text(text_slice(trimmed, colon + 1, text_len(trimmed)));
            if is_empty_text(name) { hir_optional_field_false() }
            else { OptionalHirField { present: true, field: HirField { name: name, ty: hir_parse_type_ref_from_name(ty_name), span: hir_span_new(0, 0) } } }
        }
    }
}

