fn mir_prog_check(prog: MirProg) -> I32 {
    if prog.funcs.len == 0 {
        1
    } else {
        if prog.funcs.f1.present == false {
            0
        } else {
            mir_fn_check(prog.funcs.f1.func)
        }
    }
}

fn mir_fn_check(func: MirFn) -> I32 {
    if func.name == "" {
        0
    } else {
        if func.code.len < 1 {
            0
        } else {
            1
        }
    }
}

fn mir_selfcheck() -> I32 {
    mir_prog_check(mir_prog_new())
}

