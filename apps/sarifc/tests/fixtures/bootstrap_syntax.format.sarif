    else if text_eq_simple(fn_name, "parse_f64") { true }
    else if text_eq_simple(fn_name, "sqrt") { true }
    else if text_eq_simple(fn_name, "f64_from_i32") { true }
    else if text_eq_simple(fn_name, "stdout_write") { true }
    else if text_eq_simple(fn_name, "stdout_write_builder") { true }
    else if text_eq_simple(fn_name, "stdin_text") { true }
    else if text_eq_simple(fn_name, "stdin_bytes") { true }
    else if text_eq_simple(fn_name, "file_open") { true }
    else if text_eq_simple(fn_name, "file_read") { true }
    else if text_eq_simple(fn_name, "file_read_to_end") { true }
    else if text_eq_simple(fn_name, "file_write") { true }
    else if text_eq_simple(fn_name, "file_size") { true }
    else if text_eq_simple(fn_name, "file_seek") { true }
    else if text_eq_simple(fn_name, "file_tell") { true }
    else if text_eq_simple(fn_name, "arg_count") { true }
    else if text_eq_simple(fn_name, "arg_text") { true }
    else if text_eq_simple(fn_name, "is_empty") { true }
    else if text_eq_simple(fn_name, "len") { true }
    else { false }
}

fn infer_binary_op_result_type(op: Text, left_type: Text, right_type: Text) -> Text {
    if text_eq_simple(op, "+") or text_eq_simple(op, "-") or text_eq_simple(op, "*") or text_eq_simple(op, "/") or text_eq_simple(op, "%") {
        if text_eq_simple(left_type, "I32") { "I32" }
        else if text_eq_simple(left_type, "F64") { "F64" }
        else { "I32" }
    }
    else if text_eq_simple(op, "==") or text_eq_simple(op, "!=") or text_eq_simple(op, "<") or text_eq_simple(op, ">") or text_eq_simple(op, "<=") or text_eq_simple(op, ">=") {
        "Bool"
    }
    else if text_eq_simple(op, "and") or text_eq_simple(op, "or") {
        "Bool"
    }
    else { "I32" }
}

fn infer_unary_op_result_type(op: Text, operand_type: Text) -> Text {
    if text_eq_simple(op, "-") {
        if text_eq_simple(operand_type, "I32") { "I32" }
        else if text_eq_simple(operand_type, "F64") { "F64" }
        else { "I32" }
    }
    else if text_eq_simple(op, "not") {
        "Bool"
    }
    else { "I32" }
}

fn typecheck_hir_module(module: HirModuleData) -> Text {
    let mut diags = "";
    
    let mut known_types = "I32\nF64\nBool\nText\nBytes\nUnit\nTextIndex\nTextBuilder\nFile\nList";
    
    let mut i = 1;
    let enums_list = module.enums;
    while i <= enums_list.len and i <= 16 {
        let opt = if i == 1 { enums_list.e1 }
             else if i == 2 { enums_list.e2 }
             else if i == 3 { enums_list.e3 }
             else if i == 4 { enums_list.e4 }
             else if i == 5 { enums_list.e5 }
             else if i == 6 { enums_list.e6 }
             else if i == 7 { enums_list.e7 }
             else if i == 8 { enums_list.e8 }
             else if i == 9 { enums_list.e9 }
             else if i == 10 { enums_list.e10 }
             else if i == 11 { enums_list.e11 }
             else if i == 12 { enums_list.e12 }
             else if i == 13 { enums_list.e13 }
             else if i == 14 { enums_list.e14 }
             else if i == 15 { enums_list.e15 }
             else { enums_list.e16 };
        if opt.present {
            let e = opt.e;
            known_types = add_name_to_table(known_types, e.name);
            let mut vi = 1;
            while vi <= e.variants.len {
                let vopt = if vi == 1 { e.variants.v1 }
                     else if vi == 2 { e.variants.v2 }
                     else if vi == 3 { e.variants.v3 }
                     else if vi == 4 { e.variants.v4 }
                     else if vi == 5 { e.variants.v5 }
                     else if vi == 6 { e.variants.v6 }
                     else if vi == 7 { e.variants.v7 }
                     else if vi == 8 { e.variants.v8 }
                     else if vi == 9 { e.variants.v9 }
                     else if vi == 10 { e.variants.v10 }
                     else if vi == 11 { e.variants.v11 }
                     else if vi == 12 { e.variants.v12 }
                     else if vi == 13 { e.variants.v13 }
                     else if vi == 14 { e.variants.v14 }
                     else if vi == 15 { e.variants.v15 }
                     else { e.variants.v16 };
                if vopt.present {
                    let v = vopt.variant;
                    if v.payload.present {
                        let e2 = check_type_ref_exists(v.payload.ty, known_types);
                        if not is_empty_text(e2) {
                            diags = text_concat(diags, e2);
                        };
                    };
                };
                vi = vi + 1;
            };
        };
        i = i + 1;
    };
    if i <= enums_list.len {
        diags = text_concat(diags, "error: too many enum definitions (only 16 supported)\n");
    };
    
    i = 1;
    let structs_list = module.structs;
    while i <= structs_list.len and i <= 16 {
        let opt = if i == 1 { structs_list.s1 }
             else if i == 2 { structs_list.s2 }
             else if i == 3 { structs_list.s3 }
             else if i == 4 { structs_list.s4 }
             else if i == 5 { structs_list.s5 }
             else if i == 6 { structs_list.s6 }
             else if i == 7 { structs_list.s7 }
             else if i == 8 { structs_list.s8 }
             else if i == 9 { structs_list.s9 }
             else if i == 10 { structs_list.s10 }
             else if i == 11 { structs_list.s11 }
             else if i == 12 { structs_list.s12 }
             else if i == 13 { structs_list.s13 }
             else if i == 14 { structs_list.s14 }
             else if i == 15 { structs_list.s15 }
             else { structs_list.s16 };
        if opt.present {
            let s = opt.s;
            known_types = add_name_to_table(known_types, s.name);
            let mut fi = 1;
            while fi <= s.fields.len {
                let fopt = if fi == 1 { s.fields.f1 }
                     else if fi == 2 { s.fields.f2 }
                     else if fi == 3 { s.fields.f3 }
                     else if fi == 4 { s.fields.f4 }
                     else if fi == 5 { s.fields.f5 }
                     else if fi == 6 { s.fields.f6 }
                     else if fi == 7 { s.fields.f7 }
                     else if fi == 8 { s.fields.f8 }
                     else if fi == 9 { s.fields.f9 }
                     else if fi == 10 { s.fields.f10 }
                     else if fi == 11 { s.fields.f11 }
                     else if fi == 12 { s.fields.f12 }
                     else if fi == 13 { s.fields.f13 }
                     else if fi == 14 { s.fields.f14 }
                     else if fi == 15 { s.fields.f15 }
                     else { s.fields.f16 };
                if fopt.present {
                    let e2 = check_type_ref_exists(fopt.field.ty, known_types);
                    if not is_empty_text(e2) {
                        diags = text_concat(diags, e2);
                    };
                };
                fi = fi + 1;
            };
        };
        i = i + 1;
    };
    if i <= structs_list.len {
        diags = text_concat(diags, "error: too many struct definitions (only 16 supported)\n");
    };
    
    i = 1;
    let fns_list = module.funcs;
    while i <= fns_list.len and i <= 16 {
        let opt = if i == 1 { fns_list.f1 }
             else if i == 2 { fns_list.f2 }
             else if i == 3 { fns_list.f3 }
             else if i == 4 { fns_list.f4 }
             else if i == 5 { fns_list.f5 }
             else if i == 6 { fns_list.f6 }
             else if i == 7 { fns_list.f7 }
             else if i == 8 { fns_list.f8 }
             else if i == 9 { fns_list.f9 }
             else if i == 10 { fns_list.f10 }
             else if i == 11 { fns_list.f11 }
             else if i == 12 { fns_list.f12 }
             else if i == 13 { fns_list.f13 }
             else if i == 14 { fns_list.f14 }
             else if i == 15 { fns_list.f15 }
             else { fns_list.f16 };
        if opt.present {
            let f = opt.f;
            let mut pi = 1;
            while pi <= f.params.len {
                let popt = if pi == 1 { f.params.p1 }
                     else if pi == 2 { f.params.p2 }
                     else if pi == 3 { f.params.p3 }
                     else if pi == 4 { f.params.p4 }
                     else if pi == 5 { f.params.p5 }
                     else if pi == 6 { f.params.p6 }
                     else if pi == 7 { f.params.p7 }
                     else if pi == 8 { f.params.p8 }
                     else if pi == 9 { f.params.p9 }
                     else if pi == 10 { f.params.p10 }
                     else if pi == 11 { f.params.p11 }
                     else if pi == 12 { f.params.p12 }
                     else if pi == 13 { f.params.p13 }
                     else if pi == 14 { f.params.p14 }
                     else if pi == 15 { f.params.p15 }
                     else { f.params.p16 };
                if popt.present {
                    let e2 = check_type_ref_exists(popt.param.ty, known_types);
                    if not is_empty_text(e2) {
                        diags = text_concat(diags, e2);
                    };
                };
                pi = pi + 1;
            };
            if f.ret.present {
                let e2 = check_type_ref_exists(f.ret.ty, known_types);
                if not is_empty_text(e2) {
                    diags = text_concat(diags, e2);
                };
            };
            let mut effects_seen = "";
            let mut fi = 1;
            while fi <= f.fx.len {
                let fxopt = if fi == 1 { f.fx.fx1 }
                     else if fi == 2 { f.fx.fx2 }
                     else if fi == 3 { f.fx.fx3 }
                     else if fi == 4 { f.fx.fx4 }
                     else if fi == 5 { f.fx.fx5 }
                     else if fi == 6 { f.fx.fx6 }
                     else if fi == 7 { f.fx.fx7 }
                     else if fi == 8 { f.fx.fx8 }
                     else if fi == 9 { f.fx.fx9 }
                     else if fi == 10 { f.fx.fx10 }
                     else if fi == 11 { f.fx.fx11 }
                     else if fi == 12 { f.fx.fx12 }
                     else if fi == 13 { f.fx.fx13 }
                     else if fi == 14 { f.fx.fx14 }
                     else if fi == 15 { f.fx.fx15 }
                     else { f.fx.fx16 };
                if fxopt.present {
                    let name = fxopt.name;
                    if is_empty_text(effects_seen) {
                        effects_seen = name;
                    } else {
                        diags = text_concat(diags, text_concat("warning: duplicate effect `", text_concat(name, "`\n")));
                    };
                };
                fi = fi + 1;
            };
        };
        i = i + 1;
    };
    if i <= fns_list.len {
        diags = text_concat(diags, "error: too many function definitions (only 16 supported)\n");
    };
    
    diags
}

fn analyze_borrow_escape(module: HirModuleData) -> Text {
    let mut diags = "";
    let fns = module.funcs;
    
    let mut i = 1;
    while i <= fns.len and i <= 16 {
        let opt = if i == 1 { fns.f1 }
             else if i == 2 { fns.f2 }
             else if i == 3 { fns.f3 }
             else if i == 4 { fns.f4 }
             else if i == 5 { fns.f5 }
             else if i == 6 { fns.f6 }
             else if i == 7 { fns.f7 }
             else if i == 8 { fns.f8 }
             else if i == 9 { fns.f9 }
             else if i == 10 { fns.f10 }
             else if i == 11 { fns.f11 }
             else if i == 12 { fns.f12 }
             else if i == 13 { fns.f13 }
             else if i == 14 { fns.f14 }
             else if i == 15 { fns.f15 }
             else { fns.f16 };
        if opt.present {
            let f = opt.f;
            let mut param_seen = "";
            let mut pi = 1;
            while pi <= f.params.len {
                let popt = if pi == 1 { f.params.p1 }
                     else if pi == 2 { f.params.p2 }
                     else if pi == 3 { f.params.p3 }
                     else if pi == 4 { f.params.p4 }
                     else if pi == 5 { f.params.p5 }
                     else if pi == 6 { f.params.p6 }
                     else if pi == 7 { f.params.p7 }
                     else if pi == 8 { f.params.p8 }
                     else if pi == 9 { f.params.p9 }
                     else if pi == 10 { f.params.p10 }
                     else if pi == 11 { f.params.p11 }
                     else if pi == 12 { f.params.p12 }
                     else if pi == 13 { f.params.p13 }
                     else if pi == 14 { f.params.p14 }
                     else if pi == 15 { f.params.p15 }
                     else { f.params.p16 };
                if popt.present {
                    let p = popt.param;
                    if not is_empty_text(p.name) {
                        if is_empty_text(param_seen) {
                            param_seen = p.name;
                        } else if p.name == param_seen {
                            diags = text_concat(diags, text_concat("warning: duplicate parameter name `", text_concat(p.name, "`\n")));
                        };
                    };
                };
                pi = pi + 1;
            };
        };
        i = i + 1;
    };
    if i <= fns.len {
        diags = text_concat(diags, "error: too many function definitions (only 16 supported)\n");
    };
    
    let mut ci = 1;
    let consts = module.consts;
    while ci <= consts.len and ci <= 16 {
        let opt = if ci == 1 { consts.c1 }
             else if ci == 2 { consts.c2 }
             else if ci == 3 { consts.c3 }
             else if ci == 4 { consts.c4 }
             else if ci == 5 { consts.c5 }
             else if ci == 6 { consts.c6 }
             else if ci == 7 { consts.c7 }
             else if ci == 8 { consts.c8 }
             else if ci == 9 { consts.c9 }
             else if ci == 10 { consts.c10 }
             else if ci == 11 { consts.c11 }
             else if ci == 12 { consts.c12 }
             else if ci == 13 { consts.c13 }
             else if ci == 14 { consts.c14 }
             else if ci == 15 { consts.c15 }
             else { consts.c16 };
        if opt.present {
            if is_empty_text(opt.c.name) {
                diags = text_concat(diags, "error: unnamed constant\n");
            };
        };
        ci = ci + 1;
    };
    if ci <= consts.len {
        diags = text_concat(diags, "error: too many const definitions (only 16 supported)\n");
    };
    
    diags
}

fn is_borrow_only_builtin(fn_name: Text) -> Bool {
    if text_eq_simple(fn_name, "text_len") { true }
    else if text_eq_simple(fn_name, "text_byte") { true }
    else if text_eq_simple(fn_name, "text_slice") { true }
    else if text_eq_simple(fn_name, "text_cmp") { true }
    else if text_eq_simple(fn_name, "text_eq_range") { true }
    else if text_eq_simple(fn_name, "text_intern") { true }
    else if text_eq_simple(fn_name, "bytes_len") { true }
    else if text_eq_simple(fn_name, "bytes_byte") { true }
    else if text_eq_simple(fn_name, "bytes_slice") { true }
    else if text_eq_simple(fn_name, "list_len") { true }
    else if text_eq_simple(fn_name, "list_get") { true }
    else if text_eq_simple(fn_name, "text_builder_append_i32") { true }
    else if text_eq_simple(fn_name, "text_builder_append_codepoint") { true }
    else if text_eq_simple(fn_name, "text_builder_append_ascii") { true }
    else if text_eq_simple(fn_name, "text_builder_append_slice") { true }
    else if text_eq_simple(fn_name, "text_index_get") { true }
    else if text_eq_simple(fn_name, "text_index_contains") { true }
    else if text_eq_simple(fn_name, "text_index_set") { true }
    else if text_eq_simple(fn_name, "text_index_get_or_insert") { true }
    else if text_eq_simple(fn_name, "stdout_write") { true }
    else if text_eq_simple(fn_name, "stdout_write_builder") { true }
    else if text_eq_simple(fn_name, "parse_i32_range") { true }
    else if text_eq_simple(fn_name, "file_open") { true }
    else if text_eq_simple(fn_name, "file_read") { true }
    else if text_eq_simple(fn_name, "file_read_to_end") { true }
    else if text_eq_simple(fn_name, "file_write") { true }
    else if text_eq_simple(fn_name, "file_size") { true }
    else if text_eq_simple(fn_name, "file_seek") { true }
    else if text_eq_simple(fn_name, "file_tell") { true }
    else if text_eq_simple(fn_name, "len") { true }
    else { false }
}

fn is_consuming_builtin(fn_name: Text) -> Bool {
    if text_eq_simple(fn_name, "list_push") { true }
    else if text_eq_simple(fn_name, "list_set") { true }
    else if text_eq_simple(fn_name, "list_sort_text") { true }
    else if text_eq_simple(fn_name, "list_sort_by_text_field") { true }
    else if text_eq_simple(fn_name, "text_builder_new") { true }
    else if text_eq_simple(fn_name, "text_builder_append") { true }
    else if text_eq_simple(fn_name, "text_builder_finish") { true }
    else if text_eq_simple(fn_name, "text_index_new") { true }
    else if text_eq_simple(fn_name, "parse_i32") { true }
    else if text_eq_simple(fn_name, "parse_f64") { true }
    else if text_eq_simple(fn_name, "stdin_text") { true }
    else if text_eq_simple(fn_name, "stdin_bytes") { true }
    else { false }
}

fn is_text_type(ty: Text) -> Bool {
    if text_eq_simple(ty, "Text") { true }
    else if text_eq_simple(ty, "Bytes") { true }
    else if text_eq_simple(ty, "TextBuilder") { true }
    else if text_eq_simple(ty, "TextIndex") { true }
    else if text_eq_simple(ty, "List[Text]") { true }
    else if text_eq_simple(ty, "List[TextBuilder]") { true }
    else if text_eq_simple(ty, "List[TextIndex]") { true }
    else if text_eq_simple(ty, "Optional[Text]") { true }
    else if text_eq_simple(ty, "Optional[TextBuilder]") { true }
    else if text_eq_simple(ty, "Optional[TextIndex]") { true }
    else { false }
}

fn is_affine_type(ty: Text) -> Bool {
    is_text_type(ty)
}

fn check_affine_param_usage(param_name: Text, param_type: Text, fn_name: Text) -> Text {
    if is_affine_type(param_type) and is_borrow_only_builtin(fn_name) { "" }
    else if is_affine_type(param_type) and is_consuming_builtin(fn_name) {
        text_concat("warning: consuming affine value `", text_concat(param_name, text_concat("` in `", text_concat(fn_name, "`\n"))))
    }
    else { "" }
}

fn symbol_table_has_name(table: Text, name: Text) -> Bool {
    if is_empty_text(table) {
        false
    } else {
        let mut idx = 0;
        let mut found = false;
        let t_len = text_len(table);
        let n_len = text_len(name);
        while idx <= t_len - n_len and not found {
            if text_eq_range(table, idx, idx + n_len, name) {
                let left_byte = if idx == 0 { 10 } else { text_byte(table, idx - 1) };
                let left_ok = left_byte == 10;
                let right_byte = if idx + n_len == t_len { 10 } else { text_byte(table, idx + n_len) };
                let right_ok = right_byte == 10;
                if left_ok and right_ok {
                    found = true;
                };
            };
            idx = idx + 1;
        };
        found
    }
}

fn symbol_table_add_name(table: Text, name: Text) -> Text {
    if is_empty_text(table) {
        name
    } else {
        text_concat(table, text_concat("\n", name))
    }
}

fn check_duplicate_definitions(module: HirModuleData) -> Text {
    let mut table = "";
    let mut diags = "";
    
    // 1. Check constants
    let mut i = 1;
    let list = module.consts;
    while i <= list.len and i <= 16 {
        let opt = if i == 1 { list.c1 }
             else if i == 2 { list.c2 }
             else if i == 3 { list.c3 }
             else if i == 4 { list.c4 }
             else if i == 5 { list.c5 }
             else if i == 6 { list.c6 }
             else if i == 7 { list.c7 }
             else if i == 8 { list.c8 }
             else if i == 9 { list.c9 }
             else if i == 10 { list.c10 }
             else if i == 11 { list.c11 }
             else if i == 12 { list.c12 }
             else if i == 13 { list.c13 }
             else if i == 14 { list.c14 }
             else if i == 15 { list.c15 }
             else { list.c16 };
        if opt.present {
            let name = opt.c.name;
            if symbol_table_has_name(table, name) {
                let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                diags = text_concat(diags, err);
            } else {
                table = symbol_table_add_name(table, name);
            };
        };
        i = i + 1;
    };
    if i <= list.len {
        diags = text_concat(diags, "error: too many const definitions (only 16 supported)\n");
    };
    
    // 2. Check functions
    i = 1;
    let fns = module.funcs;
    while i <= fns.len and i <= 16 {
        let opt = if i == 1 { fns.f1 }
             else if i == 2 { fns.f2 }
             else if i == 3 { fns.f3 }
             else if i == 4 { fns.f4 }
             else if i == 5 { fns.f5 }
             else if i == 6 { fns.f6 }
             else if i == 7 { fns.f7 }
             else if i == 8 { fns.f8 }
             else if i == 9 { fns.f9 }
             else if i == 10 { fns.f10 }
             else if i == 11 { fns.f11 }
             else if i == 12 { fns.f12 }
             else if i == 13 { fns.f13 }
             else if i == 14 { fns.f14 }
             else if i == 15 { fns.f15 }
             else { fns.f16 };
        if opt.present {
            let name = opt.f.name;
            if symbol_table_has_name(table, name) {
                let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                diags = text_concat(diags, err);
            } else {
                table = symbol_table_add_name(table, name);
            };
        };
        i = i + 1;
    };
    if i <= fns.len {
        diags = text_concat(diags, "error: too many function definitions (only 16 supported)\n");
    };
    
    // 3. Check structs
    i = 1;
    let structs = module.structs;
    while i <= structs.len and i <= 16 {
        let opt = if i == 1 { structs.s1 }
             else if i == 2 { structs.s2 }
             else if i == 3 { structs.s3 }
             else if i == 4 { structs.s4 }
             else if i == 5 { structs.s5 }
             else if i == 6 { structs.s6 }
             else if i == 7 { structs.s7 }
             else if i == 8 { structs.s8 }
             else if i == 9 { structs.s9 }
             else if i == 10 { structs.s10 }
             else if i == 11 { structs.s11 }
             else if i == 12 { structs.s12 }
             else if i == 13 { structs.s13 }
             else if i == 14 { structs.s14 }
             else if i == 15 { structs.s15 }
             else { structs.s16 };
        if opt.present {
            let name = opt.s.name;
            if symbol_table_has_name(table, name) {
                let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                diags = text_concat(diags, err);
            } else {
                table = symbol_table_add_name(table, name);
            };
        };
        i = i + 1;
    };
    if i <= structs.len {
        diags = text_concat(diags, "error: too many struct definitions (only 16 supported)\n");
    };
    
    // 4. Check enums
    i = 1;
    let enums = module.enums;
    while i <= enums.len and i <= 16 {
        let opt = if i == 1 { enums.e1 }
             else if i == 2 { enums.e2 }
             else if i == 3 { enums.e3 }
             else if i == 4 { enums.e4 }
             else if i == 5 { enums.e5 }
             else if i == 6 { enums.e6 }
             else if i == 7 { enums.e7 }
             else if i == 8 { enums.e8 }
             else if i == 9 { enums.e9 }
             else if i == 10 { enums.e10 }
             else if i == 11 { enums.e11 }
             else if i == 12 { enums.e12 }
             else if i == 13 { enums.e13 }
             else if i == 14 { enums.e14 }
             else if i == 15 { enums.e15 }
             else { enums.e16 };
        if opt.present {
            let name = opt.e.name;
            if symbol_table_has_name(table, name) {
                let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                diags = text_concat(diags, err);
            } else {
                table = symbol_table_add_name(table, name);
            };
        };
        i = i + 1;
    };
    if i <= enums.len {
        diags = text_concat(diags, "error: too many enum definitions (only 16 supported)\n");
    };
    
    diags
}
