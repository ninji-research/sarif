fn hir_parse_variant_from_slice(text: Text, start: I32, end: I32) -> OptionalHirVariant {
    let trimmed = hir_trim_text(text_slice(text, start, end));
    if is_empty_text(trimmed) {
        hir_optional_variant_false()
    } else {
        let paren = hir_find_open_paren(trimmed, 0, text_len(trimmed));
        if paren == -1 {
            OptionalHirVariant { present: true, variant: hir_variant_new(trimmed) }
        } else {
            let close_p = hir_find_close_paren(trimmed, paren + 1, text_len(trimmed));
            let name = hir_trim_text(text_slice(trimmed, 0, paren));
            if is_empty_text(name) { hir_optional_variant_false() }
            else {
                let payload_text = if close_p == -1 { text_slice(trimmed, paren + 1, text_len(trimmed)) }
                    else { text_slice(trimmed, paren + 1, close_p) };
                let payload_trimmed = hir_trim_text(payload_text);
                let ty = if is_empty_text(payload_trimmed) { hir_type_ref_unit() } else { hir_parse_type_ref_from_name(payload_trimmed) };
                OptionalHirVariant { present: true, variant: HirVariant { name: name, payload: hir_optional_type_ref_true(ty), span: hir_span_new(0, 0) } }
            }
        }
    }
}

