fn type_name_from_ref(ty: HirTypeRef) -> Text {
    if ty.kind == HirTypeKind.I32 { "I32" }
    else if ty.kind == HirTypeKind.F64 { "F64" }
    else if ty.kind == HirTypeKind.Bool { "Bool" }
    else if ty.kind == HirTypeKind.Text { "Text" }
    else if ty.kind == HirTypeKind.Unit { "Unit" }
    else if ty.kind == HirTypeKind.Array { text_concat("Array[", text_concat(ty.t1, "]")) }
    else if ty.kind == HirTypeKind.Named { ty.t1 }
    else if ty.kind == HirTypeKind.Optional { text_concat("Optional[", text_concat(ty.t1, "]")) }
    else { text_concat("Result[", text_concat(ty.t1, "]")) }
}

fn check_type_ref_exists(ty: HirTypeRef, known_types: Text) -> Text {
    let name = type_name_from_ref(ty);
    if ty.kind == HirTypeKind.I32 { "" }
    else if ty.kind == HirTypeKind.F64 { "" }
    else if ty.kind == HirTypeKind.Bool { "" }
    else if ty.kind == HirTypeKind.Text { "" }
    else if ty.kind == HirTypeKind.Unit { "" }
    else if ty.kind == HirTypeKind.Named {
        let mut found = false;
        let mut i = 0;
        let kt_len = text_len(known_types);
        if kt_len > 0 {
            while i <= kt_len - text_len(name) and not found {
                if text_eq_range(known_types, i, i + text_len(name), name) {
                    found = true;
                };
                i = i + 1;
            };
        };
        if not found { text_concat("error: unknown type `", text_concat(name, "`\n")) }
        else { "" }
    }
    else { "" }
}

fn add_name_to_table(table: Text, name: Text) -> Text {
    if is_empty_text(table) { name }
    else { text_concat(table, text_concat("\n", name)) }
}

fn text_eq_simple(a: Text, b: Text) -> Bool {
    text_eq_range(a, 0, text_len(a), b)
}

fn types_compatible_helper(k1: HirTypeKind, k2: HirTypeKind) -> Bool {
    if k1 == HirTypeKind.Result or k2 == HirTypeKind.Result { true }
    else if k1 == HirTypeKind.I32 and k2 == HirTypeKind.I32 { true }
    else if k1 == HirTypeKind.F64 and k2 == HirTypeKind.F64 { true }
    else if k1 == HirTypeKind.Bool and k2 == HirTypeKind.Bool { true }
    else if k1 == HirTypeKind.Text and k2 == HirTypeKind.Text { true }
    else if k1 == HirTypeKind.Unit and k2 == HirTypeKind.Unit { true }
    else if k1 == HirTypeKind.Array and k2 == HirTypeKind.Array { true }
    else if k1 == HirTypeKind.Named and k2 == HirTypeKind.Named { true }
    else if k1 == HirTypeKind.Optional and k2 == HirTypeKind.Optional { true }
    else { false }
}

fn types_compatible(ty1: HirTypeRef, ty2: HirTypeRef) -> Bool {
    let k1 = ty1.kind;
    let k2 = ty2.kind;
    if not types_compatible_helper(k1, k2) { false }
    else if k1 == HirTypeKind.Array and k2 == HirTypeKind.Array {
        text_eq_simple(ty1.t1, ty2.t1)
    }
    else if k1 == HirTypeKind.Optional and k2 == HirTypeKind.Optional {
        text_eq_simple(ty1.t1, ty2.t1)
    }
    else { true }
}

fn get_builtin_fn_return_type(fn_name: Text) -> Text {
    if text_eq_simple(fn_name, "text_len") { "I32" }
    else if text_eq_simple(fn_name, "text_byte") { "I32" }
    else if text_eq_simple(fn_name, "text_cmp") { "I32" }
    else if text_eq_simple(fn_name, "text_slice") { "Text" }
    else if text_eq_simple(fn_name, "text_concat") { "Text" }
    else if text_eq_simple(fn_name, "text_find_byte_range") { "I32" }
    else if text_eq_simple(fn_name, "bytes_find_byte_range") { "I32" }
    else if text_eq_simple(fn_name, "bytes_len") { "I32" }
    else if text_eq_simple(fn_name, "bytes_byte") { "I32" }
    else if text_eq_simple(fn_name, "bytes_slice") { "Bytes" }
    else if text_eq_simple(fn_name, "bytes_to_text") { "Text" }
    else if text_eq_simple(fn_name, "list_new") { "List" }
    else if text_eq_simple(fn_name, "list_len") { "I32" }
    else if text_eq_simple(fn_name, "list_get") { "Text" }
    else if text_eq_simple(fn_name, "list_set") { "Unit" }
    else if text_eq_simple(fn_name, "list_push") { "Unit" }
    else if text_eq_simple(fn_name, "list_sort_text") { "List" }
    else if text_eq_simple(fn_name, "list_sort_by_text_field") { "List" }
    else if text_eq_simple(fn_name, "parse_i32") { "I32" }
    else if text_eq_simple(fn_name, "parse_i32_range") { "I32" }
    else if text_eq_simple(fn_name, "parse_f64") { "F64" }
    else if text_eq_simple(fn_name, "sqrt") { "F64" }
    else if text_eq_simple(fn_name, "f64_from_i32") { "F64" }
    else if text_eq_simple(fn_name, "text_builder_new") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_append") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_append_codepoint") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_append_ascii") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_append_slice") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_append_i32") { "TextBuilder" }
    else if text_eq_simple(fn_name, "text_builder_finish") { "Text" }
    else if text_eq_simple(fn_name, "text_intern") { "Text" }
    else if text_eq_simple(fn_name, "text_promote") { "Text" }
    else if text_eq_simple(fn_name, "text_index_new") { "TextIndex" }
    else if text_eq_simple(fn_name, "text_index_get") { "I32" }
    else if text_eq_simple(fn_name, "text_index_contains") { "Bool" }
    else if text_eq_simple(fn_name, "text_index_set") { "Unit" }
    else if text_eq_simple(fn_name, "stdout_write") { "Unit" }
    else if text_eq_simple(fn_name, "stdout_write_builder") { "Unit" }
    else if text_eq_simple(fn_name, "stdin_text") { "Text" }
    else if text_eq_simple(fn_name, "stdin_bytes") { "Bytes" }
    else if text_eq_simple(fn_name, "arg_count") { "I32" }
    else if text_eq_simple(fn_name, "arg_text") { "Text" }
    else if text_eq_simple(fn_name, "file_open") { "File" }
    else if text_eq_simple(fn_name, "file_read") { "Text" }
    else if text_eq_simple(fn_name, "file_read_to_end") { "Text" }
    else if text_eq_simple(fn_name, "file_write") { "Unit" }
    else if text_eq_simple(fn_name, "file_size") { "I32" }
    else if text_eq_simple(fn_name, "file_seek") { "I32" }
    else if text_eq_simple(fn_name, "file_tell") { "I32" }
    else if text_eq_simple(fn_name, "file_exists") { "Bool" }
    else if text_eq_simple(fn_name, "file_remove") { "I32" }
    else if text_eq_simple(fn_name, "file_is_valid") { "I32" }
    else if text_eq_simple(fn_name, "is_empty") { "Bool" }
    else if text_eq_simple(fn_name, "len") { "I32" }
    else { "I32" }
}

