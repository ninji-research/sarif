fn is_empty_text(source: Text) -> Bool {
    let length = text_len(source);
    length == 0
}

fn analyze_borrow_escape(module: HirModuleData) -> Text {
    let mut diags = "";
    let fns = module.funcs;
    
    let builtin_types_text = "I32 F64 Bool";
    
    let mut i = 1;
    while i <= 16 {
        let opt = if i == 1 { fns.f1 }
             else if i == 2 { fns.f2 }
             else if i == 3 { fns.f3 }
             else if i == 4 { fns.f4 }
             else if i == 5 { fns.f5 }
             else if i == 6 { fns.f6 }
             else if i == 7 { fns.f7 }
             else if i == 8 { fns.f8 }
             else if i == 9 { fns.f9 }
             else if i == 10 { fns.f10 }
             else if i == 11 { fns.f11 }
             else if i == 12 { fns.f12 }
             else if i == 13 { fns.f13 }
             else if i == 14 { fns.f14 }
             else if i == 15 { fns.f15 }
             else { fns.f16 };
        if opt.present {
            let f = opt.f;
            let mut pi = 1;
            let mut param_table = "";
            while pi <= f.params.len {
                let popt = if pi == 1 { f.params.p1 }
                     else if pi == 2 { f.params.p2 }
                     else if pi == 3 { f.params.p3 }
                     else if pi == 4 { f.params.p4 }
                     else if pi == 5 { f.params.p5 }
                     else if pi == 6 { f.params.p6 }
                     else if pi == 7 { f.params.p7 }
                     else if pi == 8 { f.params.p8 }
                     else if pi == 9 { f.params.p9 }
                     else if pi == 10 { f.params.p10 }
                     else if pi == 11 { f.params.p11 }
                     else if pi == 12 { f.params.p12 }
                     else if pi == 13 { f.params.p13 }
                     else if pi == 14 { f.params.p14 }
                     else if pi == 15 { f.params.p15 }
                     else { f.params.p16 };
                if popt.present {
                    if is_empty_text(param_table) {
                        param_table = popt.param.name;
                    } else {
                        param_table = text_concat(param_table, text_concat(" ", popt.param.name));
                    };
                };
                pi = pi + 1;
            };
            
            if f.body.present {
                if is_empty_text(f.name) {
                    diags = text_concat(diags, "warning: unnamed function body exists\n");
                };
            };
        };
        i = i + 1;
    };
    diags
}
