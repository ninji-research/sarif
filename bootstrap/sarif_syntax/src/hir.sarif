    consts: HirConstList,
    funcs: HirFnList2,
    enums: HirEnumList,
    structs: HirStructList,
    exprs: HirExprPool,
    bodies: HirBodyPool,
}

fn hir_type_ref_i32() -> HirTypeRef {
    HirTypeRef { kind: HirTypeKind.I32, t1: "", t2: "" }
}

fn hir_type_ref_bool() -> HirTypeRef {
    HirTypeRef { kind: HirTypeKind.Bool, t1: "", t2: "" }
}

