fn hir_const_list_push(list: HirConstList, c: HirConst) -> HirConstList effects [alloc] {
    let next = list.len + 1;
    let items = list_push(list.items, list.len, c);
    HirConstList { len: next, items: items }
}

fn hir_fn_list_2_push(list: HirFnList2, f: HirFn) -> HirFnList2 effects [alloc] {
    let next = list.len + 1;
    let items = list_push(list.items, list.len, f);
    HirFnList2 { len: next, items: items }
}

fn hir_enum_list_push(list: HirEnumList, e: HirEnum) -> HirEnumList effects [alloc] {
    let next = list.len + 1;
    let items = list_push(list.items, list.len, e);
    HirEnumList { len: next, items: items }
}

fn hir_struct_list_push(list: HirStructList, s: HirStruct) -> HirStructList effects [alloc] {
    let next = list.len + 1;
    let items = list_push(list.items, list.len, s);
    HirStructList { len: next, items: items }
}

fn hir_fn_set_params(f: HirFn, params: HirParamList) -> HirFn {
    HirFn { name: f.name, params: params, ret: f.ret, fx: f.fx, req: f.req, ens: f.ens, body: f.body, span: f.span }
}

