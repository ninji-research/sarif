    HirTypeRef { kind: HirTypeKind.Named, t1: name, t2: "" }
}

fn hir_type_ref_array(elem: Text) -> HirTypeRef {
    HirTypeRef { kind: HirTypeKind.Array, t1: elem, t2: "" }
}

