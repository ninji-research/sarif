fn hir_fn_set_params(f: HirFn, params: HirParamList) -> HirFn {
    HirFn { name: f.name, params: params, ret: f.ret, fx: f.fx, req: f.req, ens: f.ens, body: f.body, span: f.span }
}

fn hir_fn_set_ret(f: HirFn, ret: OptionalHirTypeRef) -> HirFn {
    HirFn { name: f.name, params: f.params, ret: ret, fx: f.fx, req: f.req, ens: f.ens, body: f.body, span: f.span }
}

fn hir_fn_set_fx(f: HirFn, fx: HirFxList) -> HirFn {
    HirFn { name: f.name, params: f.params, ret: f.ret, fx: fx, req: f.req, ens: f.ens, body: f.body, span: f.span }
}

fn hir_fn_set_body(f: HirFn, body: OptionalHirBodyId) -> HirFn {
    HirFn { name: f.name, params: f.params, ret: f.ret, fx: f.fx, req: f.req, ens: f.ens, body: body, span: f.span }
}

fn hir_optional_binding_true(binding: HirBinding) -> OptionalHirBinding {
    OptionalHirBinding { present: true, binding: binding }
}

fn hir_optional_expr_id_true(id: HirExprId) -> OptionalHirExprId {
    OptionalHirExprId { present: true, id: id }
}

fn hir_optional_body_id_true(id: HirBodyId) -> OptionalHirBodyId {
    OptionalHirBodyId { present: true, id: id }
}

fn hir_diag_list_new() -> HirDiagList {
    HirDiagList { len: 0, d1: hir_optional_diag_false(), d2: hir_optional_diag_false() }
}

fn hir_optional_diag_false() -> OptionalHirDiag {
    OptionalHirDiag { present: false, diag: HirLoweringDiag { kind: HirLoweringDiagKind.Generic, msg: "" } }
}

fn hir_module_new() -> HirModuleData {
    HirModuleData { consts: hir_const_list_new(), funcs: hir_fn_list_2_new(), enums: hir_enum_list_new(), structs: hir_struct_list_new(), exprs: hir_expr_pool_new(), bodies: hir_body_pool_new() }
}

fn hir_module_lower(report: ModuleReport) -> HirLowering {
    let module = if report.ok {
        hir_build_module_from_outline(report.outline, report.fn_outline, report.events, "")
    } else {
        hir_module_new()
    };
    hir_module_to_lowering(module)
}

fn hir_lower_top_level(source: Text) -> HirLowering {
    let report = parse_module_report(source);
    let module = hir_module_from_report(report, source);
    hir_module_to_lowering(module)
}

fn hir_module_from_report(report: ModuleReport, source: Text) -> HirModuleData {
    if not report.ok {
        hir_module_new()
    } else {
        hir_build_module_from_outline(report.outline, report.fn_outline, report.events, source)
    }
}

fn hir_span_text(span: Span, source: Text) -> Text {
    if span.start < span.end and span.end <= text_len(source) {
        text_slice(source, span.start, span.end)
    } else {
        ""
    }
}

fn hir_name_from_span(span: OptionalSpan, source: Text) -> Text {
    if span.present {
        hir_span_text(span.span, source)
    } else {
        ""
    }
}

fn hir_build_module_from_outline(outline: TopLevelOutline, fn_outline: FnOutline, events: EventStream, source: Text) -> HirModuleData {
    let n1 = hir_name_from_span(outline.first.entry.name_span, source);
    let n2 = hir_name_from_span(outline.second.entry.name_span, source);
    let n3 = hir_name_from_span(outline.third.entry.name_span, source);
    let n4 = hir_name_from_span(outline.fourth.entry.name_span, source);
    let n5 = hir_name_from_span(outline.fifth.entry.name_span, source);
    let c1 = if outline.first.present and outline.first.entry.kind == TopLevelKind.Const {
        hir_const_list_with(hir_const_new(n1))
    } else {
        hir_const_list_new()
    };
    let c2 = if outline.second.present and outline.second.entry.kind == TopLevelKind.Const {
        hir_const_list_push(c1, hir_const_new(n2))
    } else {
        c1
    };
    let c3 = if outline.third.present and outline.third.entry.kind == TopLevelKind.Const {
        hir_const_list_push(c2, hir_const_new(n3))
    } else {
        c2
    };
    let c4 = if outline.fourth.present and outline.fourth.entry.kind == TopLevelKind.Const {
        hir_const_list_push(c3, hir_const_new(n4))
    } else {
        c3
    };
    let c5 = if outline.fifth.present and outline.fifth.entry.kind == TopLevelKind.Const {
        hir_const_list_push(c4, hir_const_new(n5))
    } else {
        c4
    };
    let f1 = if outline.first.present and outline.first.entry.kind == TopLevelKind.Fn {
        hir_fn_list_2_with(hir_fn_new(n1))
    } else {
        hir_fn_list_2_new()
    };
    let f2 = if outline.second.present and outline.second.entry.kind == TopLevelKind.Fn {
        hir_fn_list_2_push(f1, hir_fn_new(n2))
    } else {
        f1
    };
    let f3 = if outline.third.present and outline.third.entry.kind == TopLevelKind.Fn {
        hir_fn_list_2_push(f2, hir_fn_new(n3))
    } else {
        f2
    };
    let f4 = if outline.fourth.present and outline.fourth.entry.kind == TopLevelKind.Fn {
        hir_fn_list_2_push(f3, hir_fn_new(n4))
    } else {
        f3
    };
    let f5 = if outline.fifth.present and outline.fifth.entry.kind == TopLevelKind.Fn {
        hir_fn_list_2_push(f4, hir_fn_new(n5))
    } else {
        f4
    };
    let e1 = if outline.first.present and outline.first.entry.kind == TopLevelKind.Enum {
        hir_enum_list_with(hir_enum_new(n1))
    } else {
        hir_enum_list_new()
    };
    let e2 = if outline.second.present and outline.second.entry.kind == TopLevelKind.Enum {
        hir_enum_list_push(e1, hir_enum_new(n2))
    } else {
        e1
    };
    let e3 = if outline.third.present and outline.third.entry.kind == TopLevelKind.Enum {
        hir_enum_list_push(e2, hir_enum_new(n3))
    } else {
        e2
    };
    let e4 = if outline.fourth.present and outline.fourth.entry.kind == TopLevelKind.Enum {
        hir_enum_list_push(e3, hir_enum_new(n4))
    } else {
        e3
    };
    let e5 = if outline.fifth.present and outline.fifth.entry.kind == TopLevelKind.Enum {
        hir_enum_list_push(e4, hir_enum_new(n5))
    } else {
        e4
    };
    let s1 = if outline.first.present and outline.first.entry.kind == TopLevelKind.Struct {
        hir_struct_list_with(hir_struct_new(n1))
    } else {
        hir_struct_list_new()
    };
    let s2 = if outline.second.present and outline.second.entry.kind == TopLevelKind.Struct {
        hir_struct_list_push(s1, hir_struct_new(n2))
    } else {
        s1
    };
    let s3 = if outline.third.present and outline.third.entry.kind == TopLevelKind.Struct {
        hir_struct_list_push(s2, hir_struct_new(n3))
    } else {
        s2
    };
    let s4 = if outline.fourth.present and outline.fourth.entry.kind == TopLevelKind.Struct {
        hir_struct_list_push(s3, hir_struct_new(n4))
    } else {
        s3
    };
    let s5 = if outline.fifth.present and outline.fifth.entry.kind == TopLevelKind.Struct {
        hir_struct_list_push(s4, hir_struct_new(n5))
    } else {
        s4
    };
    HirModuleData { consts: c5, funcs: f5, enums: e5, structs: s5, exprs: hir_expr_pool_new(), bodies: hir_body_pool_new() }
}

fn hir_item_kind_from_top_level(kind: TopLevelKind) -> HirItemKind {
    match kind {
        TopLevelKind.Struct => {
            HirItemKind.Struct
        },
        TopLevelKind.Enum => {
            HirItemKind.Enum
        },
        TopLevelKind.Const => {
            HirItemKind.Const
        },
        TopLevelKind.Fn => {
            HirItemKind.Fn
        },
    }
}

fn hir_build_items_from_outline(outline: TopLevelOutline, fn_outline: FnOutline, source: Text) -> HirItemList {
    let i1 = if outline.first.present {
        let name = hir_name_from_span(outline.first.entry.name_span, source);
        let item = hir_item_new(hir_item_kind_from_top_level(outline.first.entry.kind), name, outline.first.entry.span);
        hir_optional_item_true(item)
    } else {
        hir_optional_item_false()
    };
    let i2 = if outline.second.present {
        let name = hir_name_from_span(outline.second.entry.name_span, source);
        let item = hir_item_new(hir_item_kind_from_top_level(outline.second.entry.kind), name, outline.second.entry.span);
        hir_optional_item_true(item)
    } else {
        hir_optional_item_false()
    };
    let i3 = if outline.third.present {
        let name = hir_name_from_span(outline.third.entry.name_span, source);
        let item = hir_item_new(hir_item_kind_from_top_level(outline.third.entry.kind), name, outline.third.entry.span);
        hir_optional_item_true(item)
    } else {
        hir_optional_item_false()
    };
    let i4 = if outline.fourth.present {
        let name = hir_name_from_span(outline.fourth.entry.name_span, source);
        let item = hir_item_new(hir_item_kind_from_top_level(outline.fourth.entry.kind), name, outline.fourth.entry.span);
        hir_optional_item_true(item)
    } else {
        hir_optional_item_false()
    };
    let i5 = if outline.fifth.present {
        let name = hir_name_from_span(outline.fifth.entry.name_span, source);
        let item = hir_item_new(hir_item_kind_from_top_level(outline.fifth.entry.kind), name, outline.fifth.entry.span);
        hir_optional_item_true(item)
    } else {
        hir_optional_item_false()
    };
    let len = if outline.first.present {
        1
    } else {
        0
    } +
    if outline.second.present {
        1
    } else {
        0
    } +
    if outline.third.present {
        1
    } else {
        0
    } +
    if outline.fourth.present {
        1
    } else {
        0
    } +
    if outline.fifth.present {
        1
    } else {
        0
    };
    HirItemList { len: len, i1: i1, i2: i2, i3: i3, i4: i4, i5: i5, i6: hir_optional_item_false(), i7: hir_optional_item_false(), i8: hir_optional_item_false(), i9: hir_optional_item_false(), i10: hir_optional_item_false(), i11: hir_optional_item_false(), i12: hir_optional_item_false(), i13: hir_optional_item_false(), i14: hir_optional_item_false(), i15: hir_optional_item_false(), i16: hir_optional_item_false() }
}

fn hir_span_from_optional(span: OptionalSpan) -> Span {
    if span.present {
        span.span
    } else {
        hir_span_new(0, 0)
    }
}

fn hir_optional_item_false() -> OptionalHirItem {
    OptionalHirItem { present: false, item: hir_item_new(HirItemKind.Fn, "", hir_span_new(0, 0)) }
}

fn hir_optional_item_true(item: HirItem) -> OptionalHirItem {
    OptionalHirItem { present: true, item: item }
}

fn hir_module_to_lowering(module: HirModuleData) -> HirLowering {
    HirLowering { module: module, expr_pool: hir_expr_pool_new(), body_pool: hir_body_pool_new(), fns: hir_fn_list_2_new(), enums: hir_enum_list_new(), structs: hir_struct_list_new(), diags: hir_diag_list_new() }
}

fn hir_selfcheck() -> I32 {
    let source = "struct Pair {}\nenum Option { none, some }\nconst answer: I32 = 42;\nfn main() -> I32 { 0 }\nfn build(x: I32) { let y = x; y }\n";
    let report = parse_module_report(source);
    if report.ok {
        let module = hir_module_from_report(report, source);
        hir_validate_module(module)
    } else {
        0
    }
}

fn hir_expr_to_mir(expr: HirExpr) -> MirBlock {
    match expr.kind {
        HirExprKind.Integer => {
            mir_block_with_inst(mir_inst_const_i32(0, expr.a))
        },
        HirExprKind.Float => {
            mir_block_new()
        },
        HirExprKind.Bool => {
            mir_block_with_inst(mir_inst_const_bool(0, if expr.a != 0 {
                true
            } else {
                false
            }))
        },
        HirExprKind.Name => {
            mir_block_with_inst(mir_inst_load_local(0))
        },
        HirExprKind.String => {
            mir_block_with_inst(mir_inst_const_text(0, expr.t1))
        },
        HirExprKind.Binary => {
            hir_binary_to_mir(expr)
        },
        HirExprKind.Unary => {
            hir_unary_to_mir(expr)
        },
        HirExprKind.Call => {
            mir_block_with_inst(mir_inst_call(0, expr.t1, expr.a, expr.b, expr.c, 0, 0))
        },
        HirExprKind.If => {
            mir_block_with_inst(mir_inst_if(0, expr.a, expr.b, expr.c))
        },
        HirExprKind.While => {
            mir_block_with_inst(mir_inst_while(0, expr.a, expr.b))
        },
        HirExprKind.Repeat => {
            mir_block_with_inst(mir_inst_repeat(0, expr.a, expr.b))
        },
        HirExprKind.Match => {
            mir_block_with_inst(mir_inst_match(0, expr.a))
        },
        HirExprKind.Field => {
            mir_block_with_inst(mir_inst_field(0, expr.a, expr.t1))
        },
        HirExprKind.Index => {
            mir_block_with_inst(mir_inst_list_get(0, expr.a, expr.b))
        },
        HirExprKind.Record => {
            mir_block_with_inst(mir_inst_make_record(0, expr.t1))
        },
        HirExprKind.Array => {
            mir_block_with_inst(mir_inst_list_new(0, expr.a, expr.b))
        },
        HirExprKind.Group => {
            mir_block_new()
        },
    }
}

fn hir_unary_to_mir(expr: HirExpr) -> MirBlock {
    let op = expr.t1;
    if op == "-" {
        mir_block_with_inst(mir_inst_neg(0, expr.a))
    } else {
        if op == "not" {
            mir_block_with_inst(mir_inst_not(0, expr.a))
        } else {
            mir_block_new()
        }
    }
}

fn hir_binary_to_mir(expr: HirExpr) -> MirBlock {
    let op = expr.t1;
    if op == "+" {
        mir_block_with_inst(mir_inst_add(0, expr.a, expr.b))
    } else {
        if op == "-" {
            mir_block_with_inst(mir_inst_sub(0, expr.a, expr.b))
        } else {
            if op == "*" {
                mir_block_with_inst(mir_inst_mul(0, expr.a, expr.b))
            } else {
                if op == "/" {
                    mir_block_with_inst(mir_inst_div(0, expr.a, expr.b))
                } else {
                    if op == "==" {
                        mir_block_with_inst(mir_inst_eq(0, expr.a, expr.b))
                    } else {
                        if op == "!=" {
                            mir_block_with_inst(mir_inst_ne(0, expr.a, expr.b))
                        } else {
                            if op == "<" {
                                mir_block_with_inst(mir_inst_lt(0, expr.a, expr.b))
                            } else {
                                if op == "<=" {
                                    mir_block_with_inst(mir_inst_le(0, expr.a, expr.b))
                                } else {
                                    if op == ">" {
                                        mir_block_with_inst(mir_inst_gt(0, expr.a, expr.b))
                                    } else {
                                        if op == ">=" {
                                            mir_block_with_inst(mir_inst_ge(0, expr.a, expr.b))
                                        } else {
                                            if op == "&&" {
                                                mir_block_with_inst(mir_inst_and(0, expr.a, expr.b))
                                            } else {
                                                if op == "||" {
                                                    mir_block_with_inst(mir_inst_or(0, expr.a, expr.b))
                                                } else {
                                                    if op == "&" {
                                                        mir_block_with_inst(mir_inst_bitand(0, expr.a, expr.b))
                                                    } else {
                                                        if op == "|" {
                                                            mir_block_with_inst(mir_inst_bitor(0, expr.a, expr.b))
                                                        } else {
                                                            if op == "^" {
                                                                mir_block_with_inst(mir_inst_bitxor(0, expr.a, expr.b))
                                                            } else {
                                                                if op == "<<" {
                                                                    mir_block_with_inst(mir_inst_shl(0, expr.a, expr.b))
                                                                } else {
                                                                    if op == ">>" {
                                                                        mir_block_with_inst(mir_inst_shr(0, expr.a, expr.b))
                                                                    } else {
                                                                        mir_block_new()
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn hir_stmt_to_mir(stmt: HirStmt) -> MirBlock {
    mir_block_new()
}

fn hir_fn_to_mir(func: HirFn) -> MirFn {
    MirFn { name: func.name, params: mir_param_list_new(), ret: mir_optional_type_false(), fx: mir_fx_list_new(), locals: mir_local_list_new(), code: mir_block_new(), result: value_id_0() }
}

fn hir_module_to_mir(module: HirModuleData) -> MirProg {
    let funcs = mir_fn_list_new();
    MirProg { funcs: funcs }
}

fn hir_validate_module(module: HirModuleData) -> I32 {
    let has_funcs = if module.funcs.len > 0 {
        1
    } else {
        0
    };
    let has_enums = if module.enums.len > 0 {
        1
    } else {
        0
    };
    let has_structs = if module.structs.len > 0 {
        1
    } else {
        0
    };
    has_funcs +
    has_enums +
    has_structs
}

fn hir_module_selfcheck(module: HirModuleData) -> I32 {
    if module.funcs.len == 0 {
        0
    } else {
        1
    }
}
