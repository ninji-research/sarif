                                            } else {
                                                if list.len == 11 {
                                                    HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: OptionalHirDiag { present: true, diag: d }, d13: list.d13, d14: list.d14, d15: list.d15, d16: list.d16 }
                                                } else {
                                                    if list.len == 12 {
                                                        HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: OptionalHirDiag { present: true, diag: d }, d14: list.d14, d15: list.d15, d16: list.d16 }
                                                    } else {
                                                        if list.len == 13 {
                                                            HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: OptionalHirDiag { present: true, diag: d }, d15: list.d15, d16: list.d16 }
                                                        } else {
                                                            if list.len == 14 {
                                                                HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: OptionalHirDiag { present: true, diag: d }, d16: list.d16 }
                                                            } else {
                                                                if list.len == 15 {
                                                                    HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: list.d15, d16: OptionalHirDiag { present: true, diag: d } }
                                                                } else {
                                                                    list
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn hir_optional_diag_false() -> OptionalHirDiag {
    OptionalHirDiag { present: false, diag: HirLoweringDiag { kind: HirLoweringDiagKind.Generic, msg: "" } }
}

fn hir_module_new() -> HirModuleData effects [alloc] {
    HirModuleData { consts: hir_const_list_new(), funcs: hir_fn_list_2_new(), enums: hir_enum_list_new(), structs: hir_struct_list_new(), exprs: hir_expr_pool_new(), bodies: hir_body_pool_new() }
}

fn hir_module_lower(report: ModuleReport) -> HirLowering effects [alloc] {
    let module = if report.ok {
        hir_build_module_from_outline(report.outline, report.fn_outline, report.events, "")
    } else {
        hir_module_new()
    };
    hir_module_to_lowering(module)
}

fn hir_lower_top_level(source: Text) -> HirLowering effects [alloc] {
    let report = parse_module_report(source);
    let module = hir_module_from_report(report, source);
    hir_module_to_lowering(module)
}

fn hir_module_from_report(report: ModuleReport, source: Text) -> HirModuleData effects [alloc] {
    if not report.ok {
        hir_module_new()
    } else {
        let module = hir_build_module_from_outline(report.outline, report.fn_outline, report.events, source);
        let enriched_funcs = hir_enrich_fn_list(module.funcs, report.fn_outline, source);
        HirModuleData { consts: module.consts, funcs: enriched_funcs, enums: module.enums, structs: module.structs, exprs: module.exprs, bodies: module.bodies }
    }
}

fn hir_span_text(span: Span, source: Text) -> Text {
    if span.start < span.end and span.end <= text_len(source) {
        text_slice(source, span.start, span.end)
    } else {
        ""
    }
}

fn hir_name_from_span(span: OptionalSpan, source: Text) -> Text {
    if span.present {
        hir_span_text(span.span, source)
    } else {
        ""
    }
}

fn hir_build_module_from_outline(outline: TopLevelOutline, fn_outline: FnOutline, events: EventStream, source: Text) -> HirModuleData effects [alloc] {
    let e1 = top_level_entry_at(outline, 0);
    let e2 = top_level_entry_at(outline, 1);
    let e3 = top_level_entry_at(outline, 2);
    let e4 = top_level_entry_at(outline, 3);
    let e5 = top_level_entry_at(outline, 4);
    let e6 = top_level_entry_at(outline, 5);
    let e7 = top_level_entry_at(outline, 6);
    let e8 = top_level_entry_at(outline, 7);
    let e9 = top_level_entry_at(outline, 8);
    let e10 = top_level_entry_at(outline, 9);
    let e11 = top_level_entry_at(outline, 10);
    let e12 = top_level_entry_at(outline, 11);
    let e13 = top_level_entry_at(outline, 12);
    let e14 = top_level_entry_at(outline, 13);
    let e15 = top_level_entry_at(outline, 14);
    let e16 = top_level_entry_at(outline, 15);
    let n1 = hir_name_from_span(e1.entry.name_span, source);
    let n2 = hir_name_from_span(e2.entry.name_span, source);
    let n3 = hir_name_from_span(e3.entry.name_span, source);
    let n4 = hir_name_from_span(e4.entry.name_span, source);
    let n5 = hir_name_from_span(e5.entry.name_span, source);
    let n6 = hir_name_from_span(e6.entry.name_span, source);
    let n7 = hir_name_from_span(e7.entry.name_span, source);
    let n8 = hir_name_from_span(e8.entry.name_span, source);
    let n9 = hir_name_from_span(e9.entry.name_span, source);
    let n10 = hir_name_from_span(e10.entry.name_span, source);
    let n11 = hir_name_from_span(e11.entry.name_span, source);
    let n12 = hir_name_from_span(e12.entry.name_span, source);
    let n13 = hir_name_from_span(e13.entry.name_span, source);
    let n14 = hir_name_from_span(e14.entry.name_span, source);
    let n15 = hir_name_from_span(e15.entry.name_span, source);
    let n16 = hir_name_from_span(e16.entry.name_span, source);
    let c1 = if e1.present and e1.entry.kind == TopLevelKind.Const { hir_const_list_with(hir_const_new(n1)) } else { hir_const_list_new() };
    let c2 = if e2.present and e2.entry.kind == TopLevelKind.Const { hir_const_list_push(c1, hir_const_new(n2)) } else { c1 };
    let c3 = if e3.present and e3.entry.kind == TopLevelKind.Const { hir_const_list_push(c2, hir_const_new(n3)) } else { c2 };
    let c4 = if e4.present and e4.entry.kind == TopLevelKind.Const { hir_const_list_push(c3, hir_const_new(n4)) } else { c3 };
    let c5 = if e5.present and e5.entry.kind == TopLevelKind.Const { hir_const_list_push(c4, hir_const_new(n5)) } else { c4 };
    let c6 = if e6.present and e6.entry.kind == TopLevelKind.Const { hir_const_list_push(c5, hir_const_new(n6)) } else { c5 };
    let c7 = if e7.present and e7.entry.kind == TopLevelKind.Const { hir_const_list_push(c6, hir_const_new(n7)) } else { c6 };
    let c8 = if e8.present and e8.entry.kind == TopLevelKind.Const { hir_const_list_push(c7, hir_const_new(n8)) } else { c7 };
    let c9 = if e9.present and e9.entry.kind == TopLevelKind.Const { hir_const_list_push(c8, hir_const_new(n9)) } else { c8 };
    let c10 = if e10.present and e10.entry.kind == TopLevelKind.Const { hir_const_list_push(c9, hir_const_new(n10)) } else { c9 };
    let c11 = if e11.present and e11.entry.kind == TopLevelKind.Const { hir_const_list_push(c10, hir_const_new(n11)) } else { c10 };
    let c12 = if e12.present and e12.entry.kind == TopLevelKind.Const { hir_const_list_push(c11, hir_const_new(n12)) } else { c11 };
    let c13 = if e13.present and e13.entry.kind == TopLevelKind.Const { hir_const_list_push(c12, hir_const_new(n13)) } else { c12 };
    let c14 = if e14.present and e14.entry.kind == TopLevelKind.Const { hir_const_list_push(c13, hir_const_new(n14)) } else { c13 };
    let c15 = if e15.present and e15.entry.kind == TopLevelKind.Const { hir_const_list_push(c14, hir_const_new(n15)) } else { c14 };
    let c16 = if e16.present and e16.entry.kind == TopLevelKind.Const { hir_const_list_push(c15, hir_const_new(n16)) } else { c15 };
    let f1 = if e1.present and e1.entry.kind == TopLevelKind.Fn { hir_fn_list_2_with(hir_fn_new(n1)) } else { hir_fn_list_2_new() };
    let f2 = if e2.present and e2.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f1, hir_fn_new(n2)) } else { f1 };
    let f3 = if e3.present and e3.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f2, hir_fn_new(n3)) } else { f2 };
    let f4 = if e4.present and e4.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f3, hir_fn_new(n4)) } else { f3 };
    let f5 = if e5.present and e5.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f4, hir_fn_new(n5)) } else { f4 };
    let f6 = if e6.present and e6.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f5, hir_fn_new(n6)) } else { f5 };
    let f7 = if e7.present and e7.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f6, hir_fn_new(n7)) } else { f6 };
    let f8 = if e8.present and e8.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f7, hir_fn_new(n8)) } else { f7 };
    let f9 = if e9.present and e9.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f8, hir_fn_new(n9)) } else { f8 };
    let f10 = if e10.present and e10.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f9, hir_fn_new(n10)) } else { f9 };
    let f11 = if e11.present and e11.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f10, hir_fn_new(n11)) } else { f10 };
    let f12 = if e12.present and e12.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f11, hir_fn_new(n12)) } else { f11 };
    let f13 = if e13.present and e13.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f12, hir_fn_new(n13)) } else { f12 };
    let f14 = if e14.present and e14.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f13, hir_fn_new(n14)) } else { f13 };
    let f15 = if e15.present and e15.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f14, hir_fn_new(n15)) } else { f14 };
    let f16 = if e16.present and e16.entry.kind == TopLevelKind.Fn { hir_fn_list_2_push(f15, hir_fn_new(n16)) } else { f15 };
    let en1 = if e1.present and e1.entry.kind == TopLevelKind.Enum {
        let e1_fresh_en = top_level_entry_at(outline, 0);
        let span_en1 = e1_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en1.start, span_en1.end);
        hir_enum_list_with(HirEnum { name: n1, variants: variants, span: hir_span_new(0, 0) })
    } else { hir_enum_list_new() };
    let en2 = if e2.present and e2.entry.kind == TopLevelKind.Enum {
        let e2_fresh_en = top_level_entry_at(outline, 1);
        let span_en2 = e2_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en2.start, span_en2.end);
        hir_enum_list_push(en1, HirEnum { name: n2, variants: variants, span: hir_span_new(0, 0) })
    } else { en1 };
    let en3 = if e3.present and e3.entry.kind == TopLevelKind.Enum {
        let e3_fresh_en = top_level_entry_at(outline, 2);
        let span_en3 = e3_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en3.start, span_en3.end);
        hir_enum_list_push(en2, HirEnum { name: n3, variants: variants, span: hir_span_new(0, 0) })
    } else { en2 };
    let en4 = if e4.present and e4.entry.kind == TopLevelKind.Enum {
        let e4_fresh_en = top_level_entry_at(outline, 3);
        let span_en4 = e4_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en4.start, span_en4.end);
        hir_enum_list_push(en3, HirEnum { name: n4, variants: variants, span: hir_span_new(0, 0) })
    } else { en3 };
    let en5 = if e5.present and e5.entry.kind == TopLevelKind.Enum {
        let e5_fresh_en = top_level_entry_at(outline, 4);
        let span_en5 = e5_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en5.start, span_en5.end);
        hir_enum_list_push(en4, HirEnum { name: n5, variants: variants, span: hir_span_new(0, 0) })
    } else { en4 };
    let en6 = if e6.present and e6.entry.kind == TopLevelKind.Enum {
        let e6_fresh_en = top_level_entry_at(outline, 5);
