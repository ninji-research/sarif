    } else { en7 };
    let en9 = if e9.present and e9.entry.kind == TopLevelKind.Enum {
        let e9_fresh_en = top_level_entry_at(outline, 8);
        let span_en9 = e9_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en9.start, span_en9.end);
        hir_enum_list_push(en8, HirEnum { name: n9, variants: variants, span: hir_span_new(0, 0) })
    } else { en8 };
    let en10 = if e10.present and e10.entry.kind == TopLevelKind.Enum {
