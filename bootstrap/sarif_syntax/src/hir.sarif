    let e4 = top_level_entry_at(outline, 4);
    let out5 = if e4.present and e4.entry.kind == TopLevelKind.Enum {
        let variants = hir_extract_variants_from_span(source, e4.entry.span.start, e4.entry.span.end);
        if ei == 0 and out4.e1.present {
            ei = ei + 1;
            HirEnumList { len: out4.len, e1: OptionalHirEnum { present: true, e: hir_enrich_enum_payload(out4.e1.e, variants) }, e2: out4.e2, e3: out4.e3, e4: out4.e4, e5: out4.e5, e6: out4.e6, e7: out4.e7, e8: out4.e8, e9: out4.e9, e10: out4.e10, e11: out4.e11, e12: out4.e12, e13: out4.e13, e14: out4.e14, e15: out4.e15, e16: out4.e16 }
        } else if ei == 1 and out4.e2.present {
            ei = ei + 1;
            HirEnumList { len: out4.len, e1: out4.e1, e2: OptionalHirEnum { present: true, e: hir_enrich_enum_payload(out4.e2.e, variants) }, e3: out4.e3, e4: out4.e4, e5: out4.e5, e6: out4.e6, e7: out4.e7, e8: out4.e8, e9: out4.e9, e10: out4.e10, e11: out4.e11, e12: out4.e12, e13: out4.e13, e14: out4.e14, e15: out4.e15, e16: out4.e16 }
        } else if ei == 2 and out4.e3.present {
            ei = ei + 1;
            HirEnumList { len: out4.len, e1: out4.e1, e2: out4.e2, e3: OptionalHirEnum { present: true, e: hir_enrich_enum_payload(out4.e3.e, variants) }, e4: out4.e4, e5: out4.e5, e6: out4.e6, e7: out4.e7, e8: out4.e8, e9: out4.e9, e10: out4.e10, e11: out4.e11, e12: out4.e12, e13: out4.e13, e14: out4.e14, e15: out4.e15, e16: out4.e16 }
        } else if ei == 3 and out4.e4.present {
            ei = ei + 1;
            HirEnumList { len: out4.len, e1: out4.e1, e2: out4.e2, e3: out4.e3, e4: OptionalHirEnum { present: true, e: hir_enrich_enum_payload(out4.e4.e, variants) }, e5: out4.e5, e6: out4.e6, e7: out4.e7, e8: out4.e8, e9: out4.e9, e10: out4.e10, e11: out4.e11, e12: out4.e12, e13: out4.e13, e14: out4.e14, e15: out4.e15, e16: out4.e16 }
        } else if ei == 4 and out4.e5.present {
            ei = ei + 1;
            HirEnumList { len: out4.len, e1: out4.e1, e2: out4.e2, e3: out4.e3, e4: out4.e4, e5: OptionalHirEnum { present: true, e: hir_enrich_enum_payload(out4.e5.e, variants) }, e6: out4.e6, e7: out4.e7, e8: out4.e8, e9: out4.e9, e10: out4.e10, e11: out4.e11, e12: out4.e12, e13: out4.e13, e14: out4.e14, e15: out4.e15, e16: out4.e16 }
        } else { out4 }
    } else { out4 };
    out5
}

fn hir_span_from_optional(span: OptionalSpan) -> Span {
    if span.present {
        span.span
    } else {
        hir_span_new(0, 0)
    }
}

fn hir_optional_item_false() -> OptionalHirItem {
    OptionalHirItem { present: false, item: hir_item_new(HirItemKind.Fn, "", hir_span_new(0, 0)) }
}

fn hir_optional_item_true(item: HirItem) -> OptionalHirItem {
    OptionalHirItem { present: true, item: item }
}

fn hir_module_to_lowering(module: HirModuleData) -> HirLowering {
    HirLowering { module: module, expr_pool: hir_expr_pool_new(), body_pool: hir_body_pool_new(), fns: hir_fn_list_2_new(), enums: hir_enum_list_new(), structs: hir_struct_list_new(), diags: hir_diag_list_new() }
}

fn is_empty_text(source: Text) -> Bool {
    let length = text_len(source);
    length == 0
}

fn hir_selfcheck() -> I32 {
    let source = "struct Pair { first: I32, second: F64 }\nenum Option { none, some(Text) }\nconst answer: I32 = 42;\nfn main() -> I32 { 0 }\nfn build(x: I32, y: Bool) -> F64 { 0.0 }\n";
    let report1 = parse_module_report(source);
    if report1.ok {
        let module1 = hir_module_from_report(report1, source);
        let resolve_diags = check_duplicate_definitions(module1);
        let report2 = parse_module_report(source);
        let module2 = hir_module_from_report(report2, source);
        let typ_diags = typecheck_hir_module(module2);
        let report3 = parse_module_report(source);
        let module3 = hir_module_from_report(report3, source);
        let own_diags = analyze_borrow_escape(module3);
        let report4 = parse_module_report(source);
        let module4 = hir_module_from_report(report4, source);
        if is_empty_text(resolve_diags) and is_empty_text(typ_diags) and is_empty_text(own_diags) {
            hir_validate_module(module4)
        } else {
            0
        }
    } else {
        0
    }
}

fn hir_expr_to_mir(expr: HirExpr) -> MirBlock {
    match expr.kind {
        HirExprKind.Integer => {
            mir_block_with_inst(mir_inst_const_i32(0, expr.a))
        },
        HirExprKind.Float => {
            mir_block_new()
        },
        HirExprKind.Bool => {
            mir_block_with_inst(mir_inst_const_bool(0, if expr.a != 0 {
                true
            } else {
                false
            }))
        },
        HirExprKind.Name => {
            mir_block_with_inst(mir_inst_load_local(0))
        },
        HirExprKind.String => {
            mir_block_with_inst(mir_inst_const_text(0, expr.t1))
        },
        HirExprKind.Binary => {
            hir_binary_to_mir(expr)
        },
        HirExprKind.Unary => {
            hir_unary_to_mir(expr)
        },
        HirExprKind.Call => {
            mir_block_with_inst(mir_inst_call(0, expr.t1, expr.a, expr.b, expr.c, 0, 0))
        },
        HirExprKind.If => {
            mir_block_with_inst(mir_inst_if(0, expr.a, expr.b, expr.c))
        },
        HirExprKind.While => {
            mir_block_with_inst(mir_inst_while(0, expr.a, expr.b))
        },
        HirExprKind.Repeat => {
            mir_block_with_inst(mir_inst_repeat(0, expr.a, expr.b))
        },
        HirExprKind.Match => {
            mir_block_with_inst(mir_inst_match(0, expr.a))
        },
        HirExprKind.Field => {
            mir_block_with_inst(mir_inst_field(0, expr.a, expr.t1))
        },
        HirExprKind.Index => {
            mir_block_with_inst(mir_inst_list_get(0, expr.a, expr.b))
        },
        HirExprKind.Record => {
            mir_block_with_inst(mir_inst_make_record(0, expr.t1))
        },
        HirExprKind.Array => {
            mir_block_with_inst(mir_inst_list_new(0, expr.a, expr.b))
        },
        HirExprKind.Group => {
            mir_block_new()
        },
    }
}

fn hir_unary_to_mir(expr: HirExpr) -> MirBlock {
    let op = expr.t1;
    if op == "-" {
        mir_block_with_inst(mir_inst_neg(0, expr.a))
    } else {
        if op == "not" {
            mir_block_with_inst(mir_inst_not(0, expr.a))
        } else {
            mir_block_new()
        }
    }
}

fn operator_code(op: Text) -> I32 {
    let c = text_byte(op, 0);
    if c == 43 { 0 }
    else if c == 45 { 1 }
    else if c == 42 { 2 }
    else if c == 47 { 3 }
    else if c == 61 {
        let len = text_len(op);
        if len == 1 { 4 }
        else if text_byte(op, 1) == 61 { 5 }
        else { -1 }
    }
    else if c == 33 { 6 }
    else if c == 60 {
        let len = text_len(op);
        if len == 1 { 7 }
        else if text_byte(op, 1) == 61 { 8 }
        else if text_byte(op, 1) == 60 { 9 }
        else { -1 }
    }
    else if c == 62 {
        let len = text_len(op);
        if len == 1 { 10 }
        else if text_byte(op, 1) == 61 { 11 }
        else if text_byte(op, 1) == 62 { 12 }
        else { -1 }
    }
    else if c == 38 {
        let len = text_len(op);
        if len == 1 { 13 }
        else if text_byte(op, 1) == 38 { 14 }
        else { -1 }
    }
    else if c == 124 {
        let len = text_len(op);
        if len == 1 { 15 }
        else if text_byte(op, 1) == 124 { 16 }
        else { -1 }
    }
    else if c == 94 { 17 }
    else if c == 37 { 18 }
    else { -1 }
}

fn hir_binary_to_mir(expr: HirExpr) -> MirBlock {
    let op = expr.t1;
    let code = operator_code(op);
    match code {
        0 => mir_block_with_inst(mir_inst_add(0, expr.a, expr.b)),
        1 => mir_block_with_inst(mir_inst_sub(0, expr.a, expr.b)),
        2 => mir_block_with_inst(mir_inst_mul(0, expr.a, expr.b)),
        3 => mir_block_with_inst(mir_inst_div(0, expr.a, expr.b)),
        4 => mir_block_with_inst(mir_inst_eq(0, expr.a, expr.b)),
        5 => mir_block_with_inst(mir_inst_eq(0, expr.a, expr.b)),
        6 => mir_block_with_inst(mir_inst_ne(0, expr.a, expr.b)),
        7 => mir_block_with_inst(mir_inst_lt(0, expr.a, expr.b)),
        8 => mir_block_with_inst(mir_inst_le(0, expr.a, expr.b)),
        9 => mir_block_with_inst(mir_inst_shl(0, expr.a, expr.b)),
        10 => mir_block_with_inst(mir_inst_gt(0, expr.a, expr.b)),
        11 => mir_block_with_inst(mir_inst_ge(0, expr.a, expr.b)),
        12 => mir_block_with_inst(mir_inst_shr(0, expr.a, expr.b)),
        13 => mir_block_with_inst(mir_inst_bitand(0, expr.a, expr.b)),
        14 => mir_block_with_inst(mir_inst_and(0, expr.a, expr.b)),
        15 => mir_block_with_inst(mir_inst_bitor(0, expr.a, expr.b)),
        16 => mir_block_with_inst(mir_inst_or(0, expr.a, expr.b)),
        17 => mir_block_with_inst(mir_inst_bitxor(0, expr.a, expr.b)),
        18 => mir_block_with_inst(mir_inst_rem(0, expr.a, expr.b)),
        _ => mir_block_new()
    }
}

fn hir_stmt_to_mir(stmt: HirStmt) -> MirBlock {
    mir_block_new()
}

fn hir_fn_to_mir(func: HirFn) -> MirFn {
    MirFn { name: func.name, params: mir_param_list_new(), ret: mir_optional_type_false(), fx: mir_fx_list_new(), locals: mir_local_list_new(), code: mir_block_new(), result: value_id_0() }
}

fn hir_module_to_mir(module: HirModuleData) -> MirProg {
    let funcs = mir_fn_list_new();
    MirProg { funcs: funcs }
}

fn hir_validate_module(module: HirModuleData) -> I32 {
    let has_funcs = if module.funcs.len > 0 {
        1
    } else {
        0
    };
    let has_enums = if module.enums.len > 0 {
        1
    } else {
        0
    };
    let has_structs = if module.structs.len > 0 {
        1
    } else {
        0
    };
    has_funcs +
    has_enums +
    has_structs
}

fn hir_module_selfcheck(module: HirModuleData) -> I32 {
    if module.funcs.len == 0 {
        0
    } else {
        1
    }
}
