    let next = list.len + 1;
    if list.len == 0 {
        HirStructList { len: next, s1: OptionalHirStruct { present: true, s: s }, s2: list.s2, s3: list.s3, s4: list.s4, s5: list.s5, s6: list.s6, s7: list.s7, s8: list.s8, s9: list.s9, s10: list.s10, s11: list.s11, s12: list.s12, s13: list.s13, s14: list.s14, s15: list.s15, s16: list.s16 }
