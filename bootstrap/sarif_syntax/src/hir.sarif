                        HirDiagList { len: next, d1: list.d1, d2: list.d2, d3: list.d3, d4: list.d4, d5: OptionalHirDiag { present: true, diag: d }, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: list.d15, d16: list.d16 }
