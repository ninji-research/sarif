        hir_enum_list_push(en5, HirEnum { name: n6, variants: variants, span: hir_span_new(0, 0) })
    } else { en5 };
    let en7 = if e7.present and e7.entry.kind == TopLevelKind.Enum {
        let e7_fresh_en = top_level_entry_at(outline, 6);
        let span_en7 = e7_fresh_en.entry.span;
        let variants = hir_extract_variants_from_span(source, span_en7.start, span_en7.end);
        hir_enum_list_push(en6, HirEnum { name: n7, variants: variants, span: hir_span_new(0, 0) })
    } else { en6 };
    let en8 = if e8.present and e8.entry.kind == TopLevelKind.Enum {
