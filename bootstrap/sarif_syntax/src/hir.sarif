}

fn hir_fn_set_body(f: HirFn, body: OptionalHirBodyId) -> HirFn {
    HirFn { name: f.name, params: f.params, ret: f.ret, fx: f.fx, req: f.req, ens: f.ens, body: body, span: f.span }
}

fn hir_optional_binding_true(binding: HirBinding) -> OptionalHirBinding {
    OptionalHirBinding { present: true, binding: binding }
}

fn hir_optional_expr_id_true(id: HirExprId) -> OptionalHirExprId {
    OptionalHirExprId { present: true, id: id }
}

fn hir_optional_body_id_true(id: HirBodyId) -> OptionalHirBodyId {
    OptionalHirBodyId { present: true, id: id }
}

fn hir_diag_list_new() -> HirDiagList {
    HirDiagList { len: 0, d1: hir_optional_diag_false(), d2: hir_optional_diag_false(), d3: hir_optional_diag_false(), d4: hir_optional_diag_false(), d5: hir_optional_diag_false(), d6: hir_optional_diag_false(), d7: hir_optional_diag_false(), d8: hir_optional_diag_false(), d9: hir_optional_diag_false(), d10: hir_optional_diag_false(), d11: hir_optional_diag_false(), d12: hir_optional_diag_false(), d13: hir_optional_diag_false(), d14: hir_optional_diag_false(), d15: hir_optional_diag_false(), d16: hir_optional_diag_false() }
}

fn hir_diag_list_with(d: HirLoweringDiag) -> HirDiagList {
    HirDiagList { len: 1, d1: OptionalHirDiag { present: true, diag: d }, d2: hir_optional_diag_false(), d3: hir_optional_diag_false(), d4: hir_optional_diag_false(), d5: hir_optional_diag_false(), d6: hir_optional_diag_false(), d7: hir_optional_diag_false(), d8: hir_optional_diag_false(), d9: hir_optional_diag_false(), d10: hir_optional_diag_false(), d11: hir_optional_diag_false(), d12: hir_optional_diag_false(), d13: hir_optional_diag_false(), d14: hir_optional_diag_false(), d15: hir_optional_diag_false(), d16: hir_optional_diag_false() }
}

fn hir_diag_list_push(list: HirDiagList, d: HirLoweringDiag) -> HirDiagList {
    let next = list.len + 1;
    if list.len == 0 {
        HirDiagList { len: next, d1: OptionalHirDiag { present: true, diag: d }, d2: list.d2, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: list.d15, d16: list.d16 }
    } else {
        if list.len == 1 {
            HirDiagList { len: next, d1: list.d1, d2: OptionalHirDiag { present: true, diag: d }, d3: list.d3, d4: list.d4, d5: list.d5, d6: list.d6, d7: list.d7, d8: list.d8, d9: list.d9, d10: list.d10, d11: list.d11, d12: list.d12, d13: list.d13, d14: list.d14, d15: list.d15, d16: list.d16 }
        } else {
