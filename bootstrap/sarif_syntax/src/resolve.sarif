    else if text_eq_simple(name, "list_sort_by_text_field") { true }
    else if text_eq_simple(name, "parse_i32") { true }
    else if text_eq_simple(name, "parse_i32_range") { true }
    else if text_eq_simple(name, "parse_f64") { true }
    else if text_eq_simple(name, "sqrt") { true }
    else if text_eq_simple(name, "f64_from_i32") { true }
    else if text_eq_simple(name, "stdout_write") { true }
    else if text_eq_simple(name, "stdout_write_builder") { true }
    else if text_eq_simple(name, "stdin_text") { true }
    else if text_eq_simple(name, "stdin_bytes") { true }
    else if text_eq_simple(name, "file_open") { true }
    else if text_eq_simple(name, "file_read") { true }
    else if text_eq_simple(name, "file_read_to_end") { true }
    else if text_eq_simple(name, "file_write") { true }
    else if text_eq_simple(name, "file_size") { true }
    else if text_eq_simple(name, "file_seek") { true }
    else if text_eq_simple(name, "file_tell") { true }
    else if text_eq_simple(name, "arg_count") { true }
