fn symbol_table_has_name(table: Text, name: Text) -> Bool {
    if is_empty_text(table) {
        false
    } else {
        let mut idx = 0;
        let mut found = false;
        let t_len = text_len(table);
        let n_len = text_len(name);
        while idx <= t_len - n_len and not found {
            if text_eq_range(table, idx, idx + n_len, name) {
                let left_byte = if idx == 0 { 10 } else { text_byte(table, idx - 1) };
                let left_ok = left_byte == 10;
                let right_byte = if idx + n_len == t_len { 10 } else { text_byte(table, idx + n_len) };
                let right_ok = right_byte == 10;
                if left_ok and right_ok {
                    found = true;
                };
            };
            idx = idx + 1;
        };
        found
    }
}

fn symbol_table_add_name(table: Text, name: Text) -> Text {
    if is_empty_text(table) {
        name
    } else {
        text_concat(table, text_concat("\n", name))
    }
}


fn is_builtin_name(name: Text) -> Bool {
    if text_eq_simple(name, "text_len") { true }
    else if text_eq_simple(name, "text_byte") { true }
    else if text_eq_simple(name, "text_cmp") { true }
    else if text_eq_simple(name, "text_eq_range") { true }
    else if text_eq_simple(name, "text_slice") { true }
    else if text_eq_simple(name, "text_concat") { true }
    else if text_eq_simple(name, "text_find_byte_range") { true }
    else if text_eq_simple(name, "text_line_end") { true }
    else if text_eq_simple(name, "text_next_line") { true }
    else if text_eq_simple(name, "text_field_end") { true }
