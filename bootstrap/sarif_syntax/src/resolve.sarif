// bootstrap
fn symbol_table_has_name(table: Text, name: Text) -> Bool {
    if is_empty_text(table) {
        false
    } else {
        let mut idx = 0;
        let mut found = false;
        let t_len = text_len(table);
        let n_len = text_len(name);
        while idx <= t_len - n_len and not found {
            if text_eq_range(table, idx, idx + n_len, name) {
                let left_byte = if idx == 0 { 10 } else { text_byte(table, idx - 1) };
                let left_ok = left_byte == 10;
                let right_byte = if idx + n_len == t_len { 10 } else { text_byte(table, idx + n_len) };
                let right_ok = right_byte == 10;
                if left_ok and right_ok {
                    found = true;
                };
            };
            idx = idx + 1;
        };
        found
    }
}

fn symbol_table_add_name(table: Text, name: Text) -> Text {
    if is_empty_text(table) {
        name
    } else {
        text_concat(table, text_concat("\n", name))
    }
}


fn is_builtin_name(name: Text) -> Bool {
    symbol_table_has_name(
        "text_len\ntext_byte\ntext_cmp\ntext_eq_range\ntext_slice\ntext_concat\ntext_find_byte_range\ntext_line_end\ntext_next_line\ntext_field_end\ntext_next_field\nbytes_len\nbytes_byte\nbytes_slice\nbytes_find_byte_range\nbytes_field_end\nbytes_next_field\nbytes_materialize\nbytes_to_text\ntext_builder_new\ntext_builder_append\ntext_builder_append_codepoint\ntext_builder_append_ascii\ntext_builder_append_slice\ntext_builder_append_i32\ntext_builder_finish\nstdout_write_builder\ntext_index_new\ntext_index_get\ntext_index_contains\ntext_index_get_or_insert\ntext_index_set\ntext_index_keys\nlist_new\nlist_len\nlist_get\nlist_set\nlist_push\nlist_sort_text\nlist_sort_by_text_field\nparse_i32\nparse_i32_range\nparse_f64\nsqrt\nf64_from_i32\ntext_from_f64_fixed\narg_count\narg_text\nstdin_text\nstdin_bytes\nstdout_write\nalloc_push\nalloc_pop\ntext_intern\ntext_promote\nfile_open\nfile_read\nfile_read_to_end\nfile_write\nfile_size\nfile_seek\nfile_tell\nfile_close\nfile_exists\nfile_remove\nfile_is_valid\ncodepoint_to_text\nenum_to_i32\nenum_to_text\nconst_assert\nis_empty\nlen",
        name,
    )
}

fn check_duplicate_definitions(module: HirModuleData) -> Text {
    let mut table = "";
    let mut diags = "";
    
    // 1. Check constants
    let mut i = 0;
    let list = module.consts;
    while i < list.len {
        let c = list_get(list.items, i);
        let name = c.name;
        if symbol_table_has_name(table, name) {
            let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
            diags = text_concat(diags, err);
        } else {
            table = symbol_table_add_name(table, name);
        };
        i = i + 1;
    };

    // 2. Check functions
    i = 0;
    let fns = module.funcs;
    while i < fns.len {
        let f = list_get(fns.items, i);
        let name = f.name;
        if symbol_table_has_name(table, name) {
            let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
            diags = text_concat(diags, err);
        } else {
            table = symbol_table_add_name(table, name);
        };
        i = i + 1;
    };

    // 3. Check structs
    i = 0;
    let structs = module.structs;
    while i < structs.len {
        let s = list_get(structs.items, i);
        let name = s.name;
        if symbol_table_has_name(table, name) {
            let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
            diags = text_concat(diags, err);
        } else {
            table = symbol_table_add_name(table, name);
        };
        i = i + 1;
    };

    // 4. Check enums
    i = 0;
    let enums = module.enums;
    while i < enums.len {
        let e = list_get(enums.items, i);
        let name = e.name;
        if symbol_table_has_name(table, name) {
            let err = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
            diags = text_concat(diags, err);
        } else {
            table = symbol_table_add_name(table, name);
        };
        i = i + 1;
    };
    
    diags
}

