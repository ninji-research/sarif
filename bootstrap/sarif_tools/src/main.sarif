fn is_empty(source: Text) -> Bool {
    text_len(source) == 0
}

fn int_to_text(n: I32) -> Text {
    if n < 0 {
        text_concat("-", int_to_text(0 - n))
    } else if n == 0 {
        "0"
    } else if n == 1 {
        "1"
    } else if n == 2 {
        "2"
    } else if n == 3 {
        "3"
    } else if n == 4 {
        "4"
    } else if n == 5 {
        "5"
    } else if n == 6 {
        "6"
    } else if n == 7 {
        "7"
    } else if n == 8 {
        "8"
    } else if n == 9 {
        "9"
    } else {
        text_concat(int_to_text(n / 10), int_to_text(n % 10))
    }
}

fn has_terminal_newline(source: Text) -> Bool {
    if is_empty(source) {
        false
    } else {
        text_byte(source, text_len(source) - 1) == 10
    }
}

fn is_layout_byte(byte: I32) -> Bool {
    byte == 9 or
    byte == 10 or
    byte == 13 or
    byte == 32
}

fn trim_start_index(source: Text, index: I32) -> I32 {
    if index >= text_len(source) {
        index
    } else {
        if is_layout_byte(text_byte(source, index)) {
            trim_start_index(source, index + 1)
        } else {
            index
        }
    }
}

fn trim_end_index(source: Text, index: I32) -> I32 {
    if index <= 0 {
        0
    } else {
        if is_layout_byte(text_byte(source, index - 1)) {
            trim_end_index(source, index - 1)
        } else {
            index
        }
    }
}

fn trim_text(source: Text) -> Text {
    let start = trim_start_index(source, 0);
    let end = trim_end_index(source, text_len(source));
    if end <= start {
        ""
    } else {
        text_slice(source, start, end)
    }
}

fn trim_body_start_index(source: Text, index: I32) -> I32 {
    if index >= text_len(source) {
        index
    } else {
        let byte = text_byte(source, index);
        if byte == 10 or byte == 13 {
            trim_body_start_index(source, index + 1)
        } else {
            index
        }
    }
}

fn leading_indent_end(source: Text, index: I32) -> I32 {
    if index >= text_len(source) {
        index
    } else {
        if is_indent_byte(text_byte(source, index)) {
            leading_indent_end(source, index + 1)
        } else {
            index
        }
    }
}

fn find_line_end(source: Text, index: I32) -> I32 {
    if index >= text_len(source) {
        index
    } else {
        if text_byte(source, index) == 10 {
            index
        } else {
            find_line_end(source, index + 1)
        }
    }
}

fn text_starts_with_at(source: Text, needle: Text, index: I32) -> Bool {
    if index + text_len(needle) > text_len(source) {
        false
    } else {
        if text_slice(source, index, index + text_len(needle)) == needle {
            true
        } else {
            false
        }
    }
}

fn contains_byte(source: Text, byte: I32, index: I32) -> Bool {
    if index >= text_len(source) {
        false
    } else {
        if text_byte(source, index) == byte {
            true
        } else {
            contains_byte(source, byte, index + 1)
        }
    }
}

fn has_second_operator(content: Text, op: Text) -> Bool {
    let first = find_operator_index(content, op, 0);
    if first < 0 {
        false
    } else {
        find_operator_index(content, op, first + text_len(op)) >= 0
    }
}

fn chain_suffix(op: Text) -> Text {
    if op == " and " {
        " and"
    } else {
        if op == " or " {
            " or"
        } else {
            " +"
        }
    }
}

fn indent_text(width: I32) -> Text {
    if width <= 0 {
        ""
    } else {
        text_concat(" ", indent_text(width - 1))
    }
}

fn find_operator_index(source: Text, op: Text, index: I32) -> I32 {
    let limit = text_len(source) - text_len(op);
    let mut i = index;
    let mut found_at = -1;
    while i <= limit and found_at < 0 {
        if text_starts_with_at(source, op, i) {
            found_at = i;
        };
        i = i + 1;
    };
    found_at
}

fn format_chain_content(content: Text, op: Text, indent_width: I32) -> Text {
    let index = find_operator_index(content, op, 0);
    if index < 0 {
        content
    } else {
        let left = text_slice(content, 0, trim_end_index(content, index));
        let right = trim_text(text_slice(content, index + text_len(op), text_len(content)));
        text_concat(text_concat(left, chain_suffix(op)), text_concat("\n", text_concat(indent_text(indent_width), format_chain_content(right, op, indent_width))))
    }
}

fn line_chain_operator(content: Text) -> Text {
    let has_and = has_second_operator(content, " and ");
    let has_or = has_second_operator(content, " or ");
    let has_add = has_second_operator(content, " + ");
    if has_and {
        if has_or {
            ""
        } else {
            if has_add {
                ""
            } else {
                " and "
            }
        }
    } else {
        if has_or {
            if has_add {
                ""
            } else {
                " or "
            }
        } else {
            if has_add {
                " + "
            } else {
                ""
            }
        }
    }
}

fn rewrite_chain_line(line: Text) -> Text {
    let indent_end = leading_indent_end(line, 0);
    let content = text_slice(line, indent_end, text_len(line));
    let op = line_chain_operator(content);
    if is_empty(op) or contains_byte(content, 34, 0) or contains_byte(content, 40, 0) or contains_byte(content, 41, 0) or contains_byte(content, 91, 0) or contains_byte(content, 93, 0) or contains_byte(content, 123, 0) or contains_byte(content, 125, 0) {
        line
    } else {
        text_concat(indent_text(indent_end), format_chain_content(content, op, indent_end))
    }
}

fn find_byte_index(source: Text, byte: I32, index: I32) -> I32 {
    let len = text_len(source);
    let mut i = index;
    let mut found_at = -1;
    while i < len and found_at < 0 {
        if text_byte(source, i) == byte {
            found_at = i;
        };
        i = i + 1;
    };
    found_at
}

fn rewrite_body_lines_from(source: Text, index: I32) -> Text {
    if index >= text_len(source) {
        ""
    } else {
        let line_end = find_line_end(source, index);
        let raw_line = text_slice(source, index, line_end);
        let line = rewrite_chain_line(raw_line);
        let has_semi = contains_byte(line, 59, 0);
        let final_line = if has_semi {
            let semi_index = find_byte_index(line, 59, 0);
            if semi_index >= 0 and semi_index < text_len(line) - 1 {
                let left = text_slice(line, 0, semi_index + 1);
                let right = trim_text(text_slice(line, semi_index + 1, text_len(line)));
                if is_empty(right) {
                    left
                } else {
                    text_concat(left, text_concat("\n", text_concat(indent_text(leading_indent_end(line, 0)), rewrite_body_lines_from(right, 0))))
                }
            } else {
                line
            }
        } else {
            line
        };
        if line_end >= text_len(source) {
            final_line
        } else {
            text_concat(final_line, text_concat("\n", rewrite_body_lines_from(source, line_end + 1)))
        }
    }
}

fn indent_lines_from(source: Text, index: I32) -> Text {
    if index >= text_len(source) {
        ""
    } else {
        let line_end = find_line_end(source, index);
        let line = text_slice(source, index, line_end);
        if line_end >= text_len(source) {
            text_concat("    ", line)
        } else {
            text_concat("    ", text_concat(line, text_concat("\n", indent_lines_from(source, line_end + 1))))
        }
    }
}

fn is_indent_byte(byte: I32) -> Bool {
    byte == 9 or byte == 32
}

fn line_indent_width(source: Text, index: I32, line_end: I32) -> I32 {
    if index >= line_end {
        0
    } else {
        if is_indent_byte(text_byte(source, index)) {
            1 + line_indent_width(source, index + 1, line_end)
        } else {
            0
        }
    }
}

fn first_content_indent(source: Text, index: I32) -> I32 {
    if index >= text_len(source) {
        0
    } else {
        let line_end = find_line_end(source, index);
        let indent = line_indent_width(source, index, line_end);
        if index + indent >= line_end {
            if line_end >= text_len(source) {
                0
            } else {
                first_content_indent(source, line_end + 1)
            }
        } else {
            indent
        }
    }
}

fn strip_line_indent(source: Text, index: I32, line_end: I32, remaining: I32) -> Text {
    if index >= line_end {
        ""
    } else {
        if remaining > 0 and is_indent_byte(text_byte(source, index)) {
            strip_line_indent(source, index + 1, line_end, remaining - 1)
        } else {
            text_slice(source, index, line_end)
        }
    }
}

fn strip_indent_lines_from(source: Text, index: I32, indent: I32) -> Text {
    if index >= text_len(source) {
        ""
    } else {
        let line_end = find_line_end(source, index);
        let line = strip_line_indent(source, index, line_end, indent);
        if line_end >= text_len(source) {
            line
        } else {
            text_concat(line, text_concat("\n", strip_indent_lines_from(source, line_end + 1, indent)))
        }
    }
}

fn top_level_source_text(source: Text, entry: TopLevelEntry) -> Text {
    text_slice(source, entry.span.start, entry.span.end)
}

fn span_text(source: Text, span: OptionalSpan) -> Text {
    if span.present {
        text_slice(source, span.span.start, span.span.end)
    } else {
        ""
    }
}

fn body_source_text(source: Text, shape: FnHeaderShape) -> Text {
    if shape.body_span.present {
        let raw = span_text(source, shape.body_span);
        let start = trim_body_start_index(raw, 0);
        let end = trim_end_index(raw, text_len(raw));
        if end <= start {
            ""
        } else {
            let body_start = if text_byte(raw, start) == 123 { start + 1 } else { start };
            let body_end = if body_start < end and text_byte(raw, end - 1) == 125 {
                end - 1
            } else {
                end
            };
            let body = text_slice(raw, body_start, body_end);
            let inner_start = trim_body_start_index(body, 0);
            let inner_end = trim_end_index(body, text_len(body));
            let trimmed = if inner_end <= inner_start {
                ""
            } else {
                text_slice(body, inner_start, inner_end)
            };
            if is_empty(trimmed) {
                ""
            } else {
                rewrite_body_lines_from(
                    strip_indent_lines_from(trimmed, 0, first_content_indent(trimmed, 0)),
                    0,
                )
            }
        }
    } else {
        ""
    }
}

fn top_level_kind_text(kind: TopLevelKind) -> Text {
    match kind {
        TopLevelKind.Struct => {
            "struct"
        },
        TopLevelKind.Enum => {
            "enum"
        },
        TopLevelKind.Const => {
            "const"
        },
        TopLevelKind.Fn => {
            "fn"
        },
    }
}

fn top_level_name_text(source: Text, entry: TopLevelEntry) -> Text {
    if entry.name_span.present {
        text_slice(source, entry.name_span.span.start, entry.name_span.span.end)
    } else {
        "_"
    }
}

fn name_text(source: Text, span: OptionalSpan) -> Text {
    if span.present {
        text_slice(source, span.span.start, span.span.end)
    } else {
        "_"
    }
}

fn count_enum_variants(source: Text, start: I32, end: I32) -> I32 {
    if end <= start {
        0
    } else {
        let body_text = text_slice(source, start, end);
        let open_brace = find_byte_index(body_text, 123, 0);
        let close_brace = find_byte_index(body_text, 125, open_brace + 1);
        if open_brace < 0 or close_brace < 0 or close_brace <= open_brace + 1 {
            0
        } else {
            let variants_text = text_slice(body_text, open_brace + 1, close_brace);
            let len = text_len(variants_text);
            if len == 0 {
                0
            } else {
                let mut count = 0;
                let mut i = 0;
                let mut after_comma = true;
                while i < len {
                    let b = text_byte(variants_text, i);
                    if b == 44 {
                        count = count + 1;
                        after_comma = true;
                    } else if not (b == 9 or b == 10 or b == 13 or b == 32) {
                        after_comma = false;
                    };
                    i = i + 1;
                };
                if not after_comma {
                    count = count + 1;
                };
                count
            }
        }
    }
}

fn append_span_text(source: Text, current: Text, prefix: Text, span: OptionalSpan) -> Text {
    if span.present {
        text_concat(current, text_concat(prefix, span_text(source, span)))
    } else {
        current
    }
}

fn fn_signature_text(source: Text, entry: TopLevelEntry, shape: FnHeaderShape) -> Text {
    let base = text_concat("fn ", text_concat(top_level_name_text(source, entry), span_text(source, shape.params_span)));
    let with_return = if shape.return_span.present {
        text_concat(base, text_concat(" -> ", span_text(source, shape.return_span)))
    } else {
        base
    };
    let with_effects = append_span_text(source, with_return, " ", shape.effects_span);
    let with_requires = append_span_text(source, with_effects, " ", shape.requires_span);
    append_span_text(source, with_requires, " ", shape.ensures_span)
}

fn format_fn_entry_text(source: Text, entry: TopLevelEntry, shape: FnHeaderShape) -> Text {
    let sig = fn_signature_text(source, entry, shape);
    let body = body_source_text(source, shape);
    if is_empty(body) {
        text_concat(sig, " {\n}")
    } else {
        text_concat(sig, text_concat(" {\n", text_concat(indent_lines_from(body, 0), "\n}")))
    }
}

fn format_stream_from(source: Text, state: ParseState) -> Text {
    if state.status == ParseStatus.Err or state.cursor.kind == TokenKind.Eof {
        ""
    } else {
        let item_start = state.cursor.start;
        let name_span = top_level_name_span(source, state);
        if state.cursor.kind == TokenKind.KwStruct {
            let next = parse_struct_item(source, state);
            let current = top_level_source_text(source, present_top_level_entry(TopLevelKind.Struct, item_start, next.last_end, name_span).entry);
            let rest = format_stream_from(source, next);
            if is_empty(rest) {
                current
            } else {
                text_concat(current, text_concat("\n\n", rest))
            }
        } else {
            if state.cursor.kind == TokenKind.KwEnum {
                let next = parse_enum_item(source, state);
                let current = top_level_source_text(source, present_top_level_entry(TopLevelKind.Enum, item_start, next.last_end, name_span).entry);
                let rest = format_stream_from(source, next);
                if is_empty(rest) {
                    current
                } else {
                    text_concat(current, text_concat("\n\n", rest))
                }
            } else {
                if state.cursor.kind == TokenKind.KwConst {
                    let next = parse_const_item(source, state);
                    let current = top_level_source_text(source, present_top_level_entry(TopLevelKind.Const, item_start, next.last_end, name_span).entry);
                    let rest = format_stream_from(source, next);
                    if is_empty(rest) {
                        current
                    } else {
                        text_concat(current, text_concat("\n\n", rest))
                    }
                } else {
                    if state.cursor.kind == TokenKind.KwFn {
                        let parsed = parse_fn_item_with_shape(source, state);
                        let entry = make_top_level_entry(TopLevelKind.Fn, make_span(item_start, item_start), name_span);
                        let current_fn = format_fn_entry_text(source, entry, parsed.shape);
                        let rest = format_stream_from(source, parsed.state);
                        if is_empty(rest) {
                            current_fn
                        } else {
                            text_concat(current_fn, text_concat("\n\n", rest))
                        }
                    } else {
                        ""
                    }
                }
            }
        }
    }
}

fn format_text(source: Text) -> Text {
    let report = parse_module_report(source);
    let formatted = if report.ok {
        format_stream_from(source, parse_state_new(source))
    } else {
        source
    };
    if has_terminal_newline(formatted) {
        formatted
    } else {
        text_concat(formatted, "\n")
    }
}

fn block_item_kind_text(kind: BlockItemKind) -> Text {
    match kind {
        BlockItemKind.Let => {
            "let"
        },
        BlockItemKind.Assign => {
            "assign"
        },
        BlockItemKind.ExprStmt => {
            "expr"
        },
        BlockItemKind.TailExpr => {
            "tail"
        },
    }
}

fn expr_kind_text(kind: ExprKind) -> Text {
    match kind {
        ExprKind.Name => {
            "name"
        },
        ExprKind.Integer => {
            "integer"
        },
        ExprKind.Float => {
            "float"
        },
        ExprKind.String => {
            "string"
        },
        ExprKind.Bool => {
            "bool"
        },
        ExprKind.Group => {
            "group"
        },
        ExprKind.Array => {
            "array"
        },
        ExprKind.Record => {
            "record"
        },
        ExprKind.If => {
            "if"
        },
        ExprKind.Match => {
            "match"
        },
        ExprKind.Repeat => {
            "repeat"
        },
        ExprKind.While => {
            "while"
        },
        ExprKind.Call => {
            "call"
        },
        ExprKind.Index => {
            "index"
        },
        ExprKind.Binary => {
            "binary"
        },
        ExprKind.Unary => {
            "unary"
        },
    }
}

fn block_item_text(entry: BlockItemEntry) -> Text {
    text_concat(block_item_kind_text(entry.kind), text_concat(" ", expr_kind_text(entry.expr_kind)))
}

fn body_outline_text_from(outline: BlockOutline, index: I32) -> Text {
    if index >= outline.total_count {
        ""
    } else {
        let item = block_item_entry_at(outline, index);
        if item.present {
            let current = block_item_text(item.entry);
            let rest = body_outline_text_from(outline, index + 1);
            if is_empty(rest) {
                current
            } else {
                text_concat(current, text_concat(", ", rest))
            }
        } else {
            body_outline_text_from(outline, index + 1)
        }
    }
}

fn body_outline_text(outline: BlockOutline) -> Text {
    if outline.total_count == 0 {
        "empty"
    } else {
        body_outline_text_from(outline, 0)
    }
}

fn doc_entry_text(source: Text, entry: TopLevelEntry) -> Text {
    text_concat("- ", text_concat(top_level_kind_text(entry.kind), text_concat(" ", text_concat(top_level_name_text(source, entry), "\n"))))
}

fn doc_non_fn_entry_text(source: Text, entry: TopLevelEntry) -> Text {
    text_concat(doc_entry_text(source, entry), text_concat("  decl: ", text_concat(top_level_source_text(source, entry), "\n")))
}

fn doc_fn_entry_text(source: Text, entry: TopLevelEntry, shape: FnHeaderShape) -> Text {
    text_concat("- ", text_concat(fn_signature_text(source, entry, shape), text_concat("\n  body: ", text_concat(body_outline_text(shape.body_outline), "\n"))))
}

fn outline_text_from(source: Text, state: ParseState) -> Text {
    if state.status == ParseStatus.Err or state.cursor.kind == TokenKind.Eof {
        ""
    } else {
        let item_start = state.cursor.start;
        let name_span = top_level_name_span(source, state);
        if state.cursor.kind == TokenKind.KwStruct {
            let next = parse_struct_item(source, state);
            let entry = present_top_level_entry(TopLevelKind.Struct, item_start, next.last_end, name_span).entry;
            text_concat(doc_non_fn_entry_text(source, entry), outline_text_from(source, next))
        } else {
            if state.cursor.kind == TokenKind.KwEnum {
                let next = parse_enum_item(source, state);
                let entry = present_top_level_entry(TopLevelKind.Enum, item_start, next.last_end, name_span).entry;
                text_concat(doc_non_fn_entry_text(source, entry), outline_text_from(source, next))
            } else {
                if state.cursor.kind == TokenKind.KwConst {
                    let next = parse_const_item(source, state);
                    let entry = present_top_level_entry(TopLevelKind.Const, item_start, next.last_end, name_span).entry;
                    text_concat(doc_non_fn_entry_text(source, entry), outline_text_from(source, next))
                } else {
                    if state.cursor.kind == TokenKind.KwFn {
                        let parsed = parse_fn_item_with_shape(source, state);
                        let entry = make_top_level_entry(TopLevelKind.Fn, make_span(item_start, item_start), name_span);
                        text_concat(doc_fn_entry_text(source, entry, parsed.shape), outline_text_from(source, parsed.state))
                    } else {
                        ""
                    }
                }
            }
        }
    }
}

fn contains_blocked_effect(source: Text, span: OptionalSpan) -> Bool {
    if span.present {
        let text = span_text(source, span);
        if text_starts_with_at(text, "io", 0) or text_starts_with_at(text, "alloc", 0) or text_starts_with_at(text, "async", 0) or text_starts_with_at(text, "parallel", 0) {
            true
        } else {
            let io_idx = find_operator_index(text, "io", 0);
            let alloc_idx = find_operator_index(text, "alloc", 0);
            let async_idx = find_operator_index(text, "async", 0);
            let parallel_idx = find_operator_index(text, "parallel", 0);
            io_idx >= 0 or alloc_idx >= 0 or async_idx >= 0 or parallel_idx >= 0
        }
    } else {
        false
    }
}

fn fn_has_blocked_effect(source: Text, shape: FnHeaderShape) -> Bool {
    contains_blocked_effect(source, shape.effects_span)
}

fn extract_const_value_from_span(source: Text, item_start: I32, item_end: I32) -> Text {
    let item_text = text_slice(source, item_start, item_end);
    let eq_pos = find_byte_index(item_text, 61, 0);
    if eq_pos >= 0 {
        let value_start = eq_pos + 1;
        let value_text = text_slice(item_text, value_start, text_len(item_text));
        let trimmed = trim_text(value_text);
        let last_idx = text_len(trimmed) - 1;
        if last_idx >= 0 and text_byte(trimmed, last_idx) == 59 {
            text_slice(trimmed, 0, last_idx)
        } else {
            trimmed
        }
    } else {
        "?"
    }
}

fn struct_body_contains_affine(source: Text, body_start: I32, body_end: I32) -> Bool {
    if body_end <= body_start {
        false
    } else {
        let body_text = text_slice(source, body_start, body_end);
        let has_file = find_operator_index(body_text, "File", 0) >= 0;
        let has_bytes = find_operator_index(body_text, "Bytes", 0) >= 0;
        let has_text = find_operator_index(body_text, "Text", 0) >= 0;
        has_file or has_bytes or has_text
    }
}

fn outline_doc_text_from(source: Text, state: ParseState) -> Text {
    if state.status == ParseStatus.Err or state.cursor.kind == TokenKind.Eof {
        ""
    } else {
        let item_start = state.cursor.start;
        let name_span = top_level_name_span(source, state);
        if state.cursor.kind == TokenKind.KwStruct {
            let next = parse_struct_item(source, state);
            let name = name_text(source, name_span);
            let has_affine = struct_body_contains_affine(source, item_start, next.cursor.start);
            let ownership = if has_affine { "`contains affine fields`" } else { "`plain value`" };
            let rt_status = "`profile-compatible`";
            let current = text_concat("## struct ", text_concat(name, text_concat("\n\n- ownership: ", text_concat(ownership, text_concat("\n- rt status: ", text_concat(rt_status, "\n\n"))))));
            text_concat(current, outline_doc_text_from(source, next))
        } else {
            if state.cursor.kind == TokenKind.KwEnum {
                let next = parse_enum_item(source, state);
                let name = name_text(source, name_span);
                let variant_count = count_enum_variants(source, state.cursor.start, next.cursor.start);
                let variants_text = text_concat("`", text_concat(int_to_text(variant_count), "`"));
                let current = text_concat("## enum ", text_concat(name, text_concat("\n\n- variants: ", text_concat(variants_text, "\n- ownership: `plain tag`\n- rt status: `profile-compatible`\n\n"))));
                text_concat(current, outline_doc_text_from(source, next))
            } else {
                if state.cursor.kind == TokenKind.KwConst {
                    let next = parse_const_item(source, state);
                    let name = name_text(source, name_span);
                    let value = extract_const_value_from_span(source, item_start, next.cursor.start);
                    let current = text_concat("## const ", text_concat(name, text_concat("\n\n- type: `I32`\n- value: `", text_concat(value, "`\n"))));
                    text_concat(current, outline_doc_text_from(source, next))
                } else {
                    if state.cursor.kind == TokenKind.KwFn {
                        let parsed = parse_fn_item_with_shape(source, state);
                        let name = name_text(source, name_span);
                        let sig = fn_signature_text(source, make_top_level_entry(TopLevelKind.Fn, make_span(item_start, item_start), name_span), parsed.shape);
                        let ownership = if name == "main" { "`affine-safe in stage-0`" } else { "`consumes affine arguments`" };
                        let rt_status = "`profile-compatible`";
                        let current = text_concat("## fn ", text_concat(name, text_concat("\n\n- signature: `", text_concat(sig, text_concat("`\n- ownership: ", text_concat(ownership, text_concat("\n- rt status: ", text_concat(rt_status, "\n\n"))))))));
                        text_concat(current, outline_doc_text_from(source, parsed.state))
                    } else {
                        ""
                    }
                }
            }
        }
    }
}

fn outline_doc_text(source: Text) -> Text effects [alloc] {
    let mut state = parse_state_new(source);
    let mut out = text_builder_new();
    while state.status == ParseStatus.Ok and state.cursor.kind != TokenKind.Eof {
        let item_start = state.cursor.start;
        let name_span = top_level_name_span(source, state);
        if state.cursor.kind == TokenKind.KwStruct {
            let next = parse_struct_item(source, state);
            let name = name_text(source, name_span);
            let has_affine = struct_body_contains_affine(source, item_start, next.cursor.start);
            let ownership = if has_affine { "`contains affine fields`" } else { "`plain value`" };
            out += "## struct ";
            out += name;
            out += "\n\n- ownership: ";
            out += ownership;
            out += "\n- rt status: `profile-compatible`\n\n";
            state = next;
        } else if state.cursor.kind == TokenKind.KwEnum {
            let next = parse_enum_item(source, state);
            let name = name_text(source, name_span);
            let variant_count = count_enum_variants(source, item_start, next.cursor.start);
            out += "## enum ";
            out += name;
            out += "\n\n- variants: `";
            out += int_to_text(variant_count);
            out += "`\n- ownership: `plain tag`\n- rt status: `profile-compatible`\n\n";
            state = next;
        } else if state.cursor.kind == TokenKind.KwConst {
            let next = parse_const_item(source, state);
            let name = name_text(source, name_span);
            let value = extract_const_value_from_span(source, item_start, next.cursor.start);
            out += "## const ";
            out += name;
            out += "\n\n- type: `I32`\n- value: `";
            out += value;
            out += "`\n";
            state = next;
        } else if state.cursor.kind == TokenKind.KwFn {
            let parsed = parse_fn_item_with_shape(source, state);
            let name = name_text(source, name_span);
            let sig = fn_signature_text(source, make_top_level_entry(TopLevelKind.Fn, make_span(item_start, item_start), name_span), parsed.shape);
            let ownership = if name == "main" { "`affine-safe in stage-0`" } else { "`consumes affine arguments`" };
            out += "## fn ";
            out += name;
            out += "\n\n- signature: `";
            out += sig;
            out += "`\n- ownership: ";
            out += ownership;
            out += "\n- rt status: `profile-compatible`\n\n";
            state = parsed.state;
        } else {
            state = parse_fn_item(source, state);
        };
    };
    text_builder_finish(out)
}

fn doc_text(source: Text) -> Text effects [alloc] {
    let report = parse_module_report(source);
    if report.ok {
        text_concat("# Sarif Semantic Docs\n\n\n", outline_doc_text(source))
    } else {
        "# Sarif Semantic Docs\n\ninvalid\n"
    }
}

fn name_table_add(table: Text, name: Text) -> Text {
    if is_empty(table) {
        name
    } else {
        text_concat(table, text_concat("\n", name))
    }
}

fn name_table_has(table: Text, name: Text) -> Bool {
    if is_empty(table) {
        false
    } else {
        if text_starts_with_at(table, name, 0) {
            let end = text_len(name);
            end == text_len(table) or text_byte(table, end) == 10
        } else {
            let search = text_concat("\n", name);
            let mut idx = 0;
            let mut found = false;
            let mut searching = true;
            while searching {
                idx = find_operator_index(table, search, idx);
                if idx < 0 {
                    searching = false;
                } else {
                    let after = idx + text_len(search);
                    if after >= text_len(table) or text_byte(table, after) == 10 {
                        found = true;
                        searching = false;
                    } else {
                        idx = after;
                    };
                };
            };
            found
        }
    }
}

fn name_table_count(table: Text, name: Text) -> I32 {
    if is_empty(table) {
        0
    } else {
        let match_here = if text_starts_with_at(table, name, 0) {
            let end = text_len(name);
            if end == text_len(table) or text_byte(table, end) == 10 {
                1
            } else {
                0
            }
        } else {
            0
        };
        let nxt = find_byte_index(table, 10, 0);
        let rest = if nxt >= 0 {
            text_slice(table, nxt + 1, text_len(table))
        } else {
            ""
        };
        match_here + name_table_count(rest, name)
    }
}

fn extract_call_callee(expr_text: Text) -> Text {
    let paren = find_byte_index(expr_text, 40, 0);
    if paren > 0 {
        text_slice(expr_text, 0, paren)
    } else {
        expr_text
    }
}

fn collect_all_names_from(source: Text, state: ParseState, names: Text) -> Text {
    let mut cur_state = state;
    let mut cur_names = names;
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        let name_span = top_level_name_span(source, cur_state);
        cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
            parse_struct_item(source, cur_state)
        } else if cur_state.cursor.kind == TokenKind.KwEnum {
            parse_enum_item(source, cur_state)
        } else if cur_state.cursor.kind == TokenKind.KwConst {
            parse_const_item(source, cur_state)
        } else {
            parse_fn_item(source, cur_state)
        };
        let cur_name = name_text(source, name_span);
        if not is_empty(cur_name) and cur_name != "_" {
            cur_names = name_table_add(cur_names, cur_name);
        };
    };
    cur_names
}

fn collect_all_names(source: Text) -> Text {
    collect_all_names_from(source, parse_state_new(source), "")
}

fn check_duplicate_defs_from(source: Text, state: ParseState, names: Text) -> Text {
    let mut cur_state = state;
    let mut seen = "";
    let mut out = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        let name_span = top_level_name_span(source, cur_state);
        cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
            parse_struct_item(source, cur_state)
        } else if cur_state.cursor.kind == TokenKind.KwEnum {
            parse_enum_item(source, cur_state)
        } else if cur_state.cursor.kind == TokenKind.KwConst {
            parse_const_item(source, cur_state)
        } else {
            parse_fn_item(source, cur_state)
        };
        if name_span.present {
            let name = text_slice(source, name_span.span.start, name_span.span.end);
            if not is_empty(name) and name != "_" {
                if name_table_has(seen, name) {
                    let diag = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                    out = if is_empty(out) { diag } else { text_concat(out, diag) };
                } else {
                    seen = name_table_add(seen, name);
                };
            };
        };
    };
    out
}

fn is_builtin_fn(name: Text) -> Bool {
    name_table_has("text_len\ntext_byte\ntext_cmp\ntext_eq_range\ntext_slice\ntext_concat\ntext_find_byte_range\ntext_line_end\ntext_next_line\ntext_field_end\ntext_next_field\nbytes_len\nbytes_byte\nbytes_slice\nbytes_find_byte_range\ntext_builder_new\ntext_builder_append\ntext_builder_append_codepoint\ntext_builder_append_ascii\ntext_builder_append_slice\ntext_builder_append_i32\ntext_builder_finish\nstdout_write_builder\ntext_index_new\ntext_index_get\ntext_index_contains\ntext_index_get_or_insert\ntext_index_set\nlist_new\nlist_len\nlist_get\nlist_set\nlist_push\nlist_sort_text\nlist_sort_by_text_field\nparse_i32\nparse_i32_range\nparse_f64\nsqrt\nf64_from_i32\ntext_from_f64_fixed\narg_count\narg_text\nstdin_text\nstdin_bytes\nstdout_write\nalloc_push\nalloc_pop\nlen", name)
}

