fn check_expr_for_calls(source: Text, expr_span: Span, known: Text) -> Text {
    if expr_span.start >= expr_span.end {
        ""
    } else {
        let text = text_slice(source, expr_span.start, expr_span.end);
        let mut pos = find_byte_index(text, 40, 0);
        let mut out = "";
        while pos > 0 {
            let mut name_end = pos;
            let mut name_start = name_end;
            let mut searching = true;
            while name_start > 0 and searching {
                let b = text_byte(text, name_start - 1);
                if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 {
                    name_start = name_start - 1;
                } else {
                    searching = false;
                };
            };
            if name_start < name_end {
                let callee = text_slice(text, name_start, name_end);
                let before_name_is_dot = name_start > 0 and text_byte(text, name_start - 1) == 46;
                if callee != "_" and not before_name_is_dot and not name_table_has(known, callee) and not is_builtin_fn(callee) {
                    let err = text_concat("error: unknown function `", text_concat(callee, "`\n"));
                    out = if is_empty(out) { err } else { text_concat(out, err) };
                };
            };
            let next_pos = find_byte_index(text, 40, pos + 1);
            if next_pos >= 0 {
                pos = next_pos;
            } else {
                pos = -1;
            };
        };
        out
    }
}

fn check_body_outline_calls(source: Text, outline: BlockOutline, index: I32, known: Text) -> Text {
    if index >= 5 {
        ""
    } else {
        let entry = block_item_entry_at(outline, index);
        let d = if entry.present and entry.entry.expr_span.present {
            if entry.entry.expr_kind == ExprKind.Call {
                let expr_text = text_slice(source, entry.entry.expr_span.span.start, entry.entry.expr_span.span.end);
                let callee = extract_call_callee(expr_text);
                if not is_empty(callee) and callee != "_" {
                    if name_table_has(known, callee) {
                        ""
                    } else {
                        if is_builtin_fn(callee) {
                            ""
                        } else {
                            text_concat("error: unknown function `", text_concat(callee, "`\n"))
                        }
                    }
                } else {
                    ""
                }
            } else {
                check_expr_for_calls(source, entry.entry.expr_span.span, known)
            }
        } else {
            ""
        };
        let rest = check_body_outline_calls(source, outline, index + 1, known);
        if is_empty(d) {
            rest
        } else {
            text_concat(d, rest)
        }
    }
}

fn check_body_calls_from(source: Text, state: ParseState, known: Text) -> Text {
    let mut cur_state = state;
    let mut out = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwFn {
            let parsed = parse_fn_item_with_shape(source, cur_state);
            let body_diag = check_body_outline_calls(source, parsed.shape.body_outline, 0, known);
            cur_state = parsed.state;
            if not is_empty(body_diag) {
                out = if is_empty(out) { body_diag } else { text_concat(out, body_diag) };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_const_item(source, cur_state)
            };
        };
    };
    out
}

fn span_text_safe(source: Text, span: OptionalSpan) -> Text {
    if span.present {
        text_slice(source, span.span.start, span.span.end)
    } else {
        ""
    }
}

fn extract_type_text(type_text: Text) -> Text {
    let trimmed = trim_text(type_text);
    if is_empty(trimmed) {
        ""
    } else {
        trimmed
    }
}

fn is_builtin_type(name: Text) -> Bool {
    name == "I32" or name == "F64" or name == "Bool" or name == "Text" or name == "Unit" or name == "Bytes" or name == "TextIndex" or name == "TextBuilder" or name == "File" or name == "List"
}

fn is_numeric_type(ty: Text) -> Bool {
    ty == "I32" or ty == "F64"
}

fn type_table_lookup(table: Text, key: Text) -> Text {
    if is_empty(table) {
        ""
    } else {
        let sep = find_byte_index(table, 58, 0);
        let eol = find_byte_index(table, 10, 0);
        let entry_end = if eol >= 0 { eol } else { text_len(table) };
        let entry_key = text_slice(table, 0, sep);
        let entry_val = text_slice(table, sep + 1, entry_end);
        if entry_key == key {
            entry_val
        } else {
            if eol >= 0 {
                type_table_lookup(text_slice(table, eol + 1, text_len(table)), key)
            } else {
                ""
            }
        }
    }
}

fn type_table_extend(table: Text, key: Text, value: Text) -> Text {
    if is_empty(table) {
        text_concat(key, text_concat(":", value))
    } else {
        text_concat(table, text_concat("\n", text_concat(key, text_concat(":", value))))
    }
}

fn collect_struct_field_layout(body: Text) -> Text {
    let mut fields = "";
    let mut offset = 0;
    let body_len = text_len(body);
    while offset < body_len {
        let colon = find_byte_index(body, 58, offset);
        if colon < 0 {
            offset = body_len;
        } else {
            let comma = find_byte_index(body, 44, colon + 1);
            let field_end = if comma >= 0 { comma } else { body_len };
            let name = trim_text(text_slice(body, offset, colon));
            let ty = trim_text(text_slice(body, colon + 1, field_end));
            if not is_empty(name) and not is_empty(ty) {
                fields = if is_empty(fields) {
                    text_concat(name, text_concat(":", ty))
                } else {
                    text_concat(fields, text_concat(",", text_concat(name, text_concat(":", ty))))
                };
            };
            offset = if comma >= 0 { comma + 1 } else { body_len };
        };
    };
    fields
}

fn collect_struct_types(source: Text, state: ParseState) -> Text {
    let mut cur_state = state;
    let mut types = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwStruct {
            let name_span = top_level_name_span(source, cur_state);
            let open_brace = find_byte_index(source, 123, cur_state.cursor.start);
            let parsed = parse_struct_item(source, cur_state);
            cur_state = parsed;
            if name_span.present and open_brace >= 0 {
                let close_brace = find_matching_close_raw(source, open_brace);
                if close_brace > open_brace + 1 {
                    let name = text_slice(source, name_span.span.start, name_span.span.end);
                    let body = text_slice(source, open_brace + 1, close_brace - 1);
                    let fields = collect_struct_field_layout(body);
                    if not is_empty(name) and not is_empty(fields) {
                        types = type_table_extend(types, name, fields);
                    };
                };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwConst {
                parse_const_item(source, cur_state)
            } else {
                parse_fn_item(source, cur_state)
            };
        };
    };
    types
}

fn infer_name_type(name: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let dot = find_byte_index(name, 46, 0);
    if dot >= 0 {
        infer_dotted_type(name, locals, consts, fns)
    } else {
        let from_locals = type_table_lookup(locals, name);
        if not is_empty(from_locals) {
            strip_mut_prefix(from_locals)
        } else {
            let from_consts = type_table_lookup(consts, name);
            if not is_empty(from_consts) {
                from_consts
            } else {
                let from_fns = type_table_lookup(fns, name);
                if not is_empty(from_fns) {
                    from_fns
                } else {
                    ""
                }
            }
        }
    }
}

fn infer_dotted_type(name: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let dot = find_byte_index(name, 46, 0);
    if dot < 0 or dot >= text_len(name) - 1 {
        ""
    } else {
        let base_text = text_slice(name, 0, dot);
        let rest_text = text_slice(name, dot + 1, text_len(name));
        let base_type = infer_name_type(base_text, locals, consts, fns);
        if is_empty(base_type) {
            ""
        } else {
            let field_key = text_concat(base_type, text_concat(".", rest_text));
            let field_type = type_table_lookup(consts, field_key);
            if not is_empty(field_type) {
                field_type
            } else {
                let struct_fields = type_table_lookup(consts, base_type);
                if not is_empty(struct_fields) {
                    resolve_nested_struct_field(rest_text, struct_fields, consts)
                } else {
                    ""
                }
            }
        }
    }
}

fn resolve_nested_struct_field(field_path: Text, struct_fields: Text, consts: Text) -> Text {
    let dot = find_byte_index(field_path, 46, 0);
    if dot < 0 {
        resolve_struct_field(field_path, struct_fields)
    } else {
        let first_field = text_slice(field_path, 0, dot);
        let remaining = text_slice(field_path, dot + 1, text_len(field_path));
        let first_type = resolve_struct_field(first_field, struct_fields);
        if is_empty(first_type) {
            ""
        } else {
            let next_struct_fields = type_table_lookup(consts, first_type);
            if is_empty(next_struct_fields) {
                ""
            } else {
                resolve_nested_struct_field(remaining, next_struct_fields, consts)
            }
        }
    }
}

fn resolve_struct_field(field: Text, fields_text: Text) -> Text {
    if is_empty(field) or is_empty(fields_text) {
        ""
    } else {
        let colon = find_byte_index(fields_text, 58, 0);
        if colon < 0 {
            ""
        } else {
            let name_part = trim_text(text_slice(fields_text, 0, colon));
            let rest_start = colon + 1;
            let comma = find_byte_index(fields_text, 44, rest_start);
            let type_end = if comma >= 0 { comma } else { text_len(fields_text) };
            let type_part = trim_text(text_slice(fields_text, rest_start, type_end));
            if name_part == field {
                type_part
            } else {
                let next_start = if comma >= 0 { comma + 1 } else { text_len(fields_text) };
                if next_start < text_len(fields_text) {
                    let rest = text_slice(fields_text, next_start, text_len(fields_text));
                    resolve_struct_field(field, rest)
                } else {
                    ""
                }
            }
        }
    }
}

fn infer_call_ret_type(source: Text, expr_span: Span, fns: Text) -> Text {
    let expr_text = text_slice(source, expr_span.start, expr_span.end);
    let paren = find_byte_index(expr_text, 40, 0);
    if paren > 0 {
        let callee = trim_text(text_slice(expr_text, 0, paren));
        let ret_type = type_table_lookup(fns, callee);
        if is_empty(ret_type) {
            if is_builtin_fn(callee) {
                builtin_return_type(callee)
            } else {
                ""
            }
        } else {
            ret_type
        }
    } else {
        ""
    }
}

fn find_matching_close_raw(source: Text, start: I32) -> I32 {
    let open_byte = text_byte(source, start);
    let close_byte = if open_byte == 40 {
        41
    } else {
        if open_byte == 91 {
            93
        } else {
            if open_byte == 123 {
                125
            } else {
                0
            }
        }
    };
    if close_byte == 0 {
        text_len(source)
    } else {
        let mut depth = 1;
        let mut i = start + 1;
        while i < text_len(source) and depth > 0 {
            let b = text_byte(source, i);
            if b == open_byte {
                depth = depth + 1;
            } else if b == close_byte {
                depth = depth - 1;
            };
            i = i + 1;
        };
        i
    }
}

fn skip_expr_text(source: Text, start: I32) -> I32 {
    let mut i = start;
    let mut done = false;
    while i < text_len(source) and not done {
        let b = text_byte(source, i);
        let is_space = b == 32 or b == 9 or b == 10 or b == 13;
        let is_open = b == 40 or b == 91 or b == 123;
        let is_stop = b == 41 or b == 93 or b == 125 or b == 44 or b == 59;
        if is_space {
            i = i + 1;
        } else if is_open {
            i = find_matching_close_raw(source, i) + 1;
        } else if is_stop {
            done = true;
        } else {
            i = i + 1;
        };
    };
    i
}

fn find_operator_in_expr(source: Text, span: Span) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let len = text_len(expr_text);
    let mut op = "";
    let mut i = 0;
    while i < len and is_empty(op) {
        let b = text_byte(expr_text, i);
        if b == 61 {
            let is_eq = i + 1 < len and text_byte(expr_text, i + 1) == 61;
            if is_eq {
                op = "Bool";
            };
        } else if b == 33 {
            let is_ne = i + 1 < len and text_byte(expr_text, i + 1) == 61;
            if is_ne {
                op = "Bool";
            };
        } else if b == 60 {
            op = "Bool";
        } else if b == 62 {
            op = "Bool";
        } else if b == 97 or b == 111 {
            if b == 97 {
                let is_and = i + 1 < len and text_byte(expr_text, i + 1) == 110 and i + 2 < len and text_byte(expr_text, i + 2) == 100;
                if is_and {
                    op = "Bool";
                };
            } else {
                let is_or = i + 1 < len and text_byte(expr_text, i + 1) == 114;
                if is_or {
                    op = "Bool";
                };
            };
        } else if b == 43 {
            op = "Add";
        } else if b == 45 or b == 42 or b == 47 or b == 37 {
            op = "I32";
        };
        i = i + 1;
    };
    if op == "Add" {
        let mut has_text = false;
        let mut j = 0;
        while j < len and not has_text {
            let b2 = text_byte(expr_text, j);
            if b2 == 34 {
                has_text = true;
            };
            j = j + 1;
        };
        if has_text {
            "Text"
        } else {
            "I32"
        }
    } else {
        if is_empty(op) {
            ""
        } else {
            op
        }
    }
}

fn infer_binary_type_deep(source: Text, span: Span, kind: ExprKind, locals: Text, consts: Text, fns: Text) -> Text {
    find_operator_in_expr(source, span)
}

fn infer_unary_type_deep(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let trimmed = trim_text(expr_text);
    let len = text_len(trimmed);
    let mut i = 0;
    let mut op_end = -1;
    while i < len and op_end < 0 {
        let b = text_byte(trimmed, i);
        if b == 110 {
            if i + 3 < len and text_slice(trimmed, i, i + 4) == "not " {
                op_end = i + 4;
            } else {
                i = i + 1;
            };
        } else if b == 45 or b == 126 {
            op_end = i + 1;
        } else {
            i = i + 1;
        };
    };
    if op_end < 0 or op_end >= len {
        ""
    } else {
        let operand = trim_text(text_slice(trimmed, op_end, len));
        if is_empty(operand) {
            ""
        } else {
            let operand_type = infer_snippet_type(operand, locals, consts, fns);
            if is_empty(operand_type) {
                ""
            } else if text_byte(trimmed, 0) == 110 {
                "Bool"
            } else {
                operand_type
            }
        }
    }
}

fn infer_if_type_deep(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let else_pos = find_byte_index(expr_text, 101, 0);
    if else_pos < 0 {
        "Unit"
    } else {
        let after_else = else_pos + 4;
        if after_else < text_len(expr_text) {
            let else_expr = text_slice(expr_text, after_else, text_len(expr_text));
            let else_trimmed = trim_text(else_expr);
            if is_empty(else_trimmed) {
                "Unit"
            } else {
                let else_state = parse_state_new(else_trimmed);
                let else_kind = classify_expr_kind(else_trimmed, else_state);
                if else_kind == ExprKind.Integer {
                    "I32"
                } else if else_kind == ExprKind.Float {
                    "F64"
                } else if else_kind == ExprKind.Bool {
                    "Bool"
                } else if else_kind == ExprKind.String {
                    "Text"
                } else if else_kind == ExprKind.Name {
                    let name_text_val = text_slice(else_trimmed, 0, text_len(else_trimmed));
                    infer_name_type(name_text_val, locals, consts, fns)
                } else {
                    ""
                }
            }
        } else {
            "Unit"
        }
    }
}

fn infer_match_type_deep(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let brace = find_byte_index(expr_text, 123, 0);
    if brace < 0 {
        ""
    } else {
        let close = find_matching_close_raw(expr_text, brace);
        if close <= brace + 1 {
            ""
        } else {
            let body = text_slice(expr_text, brace + 1, close - 1);
            extract_match_arm_type(body, locals, consts, fns)
        }
    }
}

fn extract_match_arm_type(body: Text, locals: Text, consts: Text, fns: Text) -> Text {
    if is_empty(body) {
        ""
    } else {
        let arrow = find_byte_index(body, 61, 0);
        if arrow < 0 or arrow + 1 >= text_len(body) or not (text_byte(body, arrow + 1) == 62) {
            ""
        } else {
            let after_arrow = arrow + 2;
            if after_arrow >= text_len(body) {
                ""
            } else {
                let end = skip_expr_text(body, after_arrow);
                let arm_expr = trim_text(text_slice(body, after_arrow, end));
                infer_branch_type(arm_expr, locals, consts, fns)
            }
        }
    }
}

fn infer_group_type_deep(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let open_paren = find_byte_index(expr_text, 40, 0);
    if open_paren < 0 {
        ""
    } else {
        let close_paren = find_matching_close_raw(expr_text, open_paren);
        if close_paren <= open_paren + 1 {
            ""
        } else {
            let inner = text_slice(expr_text, open_paren + 1, close_paren - 1);
            infer_snippet_type(inner, locals, consts, fns)
        }
    }
}

fn infer_expr_type_deep(source: Text, span: Span, kind: ExprKind, locals: Text, consts: Text, fns: Text) -> Text {
    match kind {
        ExprKind.Binary => {
            infer_binary_type_deep(source, span, kind, locals, consts, fns)
        },
        ExprKind.If => {
            infer_if_type_deep(source, span, locals, consts, fns)
        },
        ExprKind.While => {
            "Unit"
        },
        ExprKind.Repeat => {
            "Unit"
        },
        ExprKind.Record => {
            let expr_text = text_slice(source, span.start, span.end);
            let brace = find_byte_index(expr_text, 123, 0);
            if brace > 0 {
                let struct_name = trim_text(text_slice(expr_text, 0, brace));
                struct_name
            } else {
                ""
            }
        },
        ExprKind.Match => {
            infer_match_type_deep(source, span, locals, consts, fns)
        },
        ExprKind.Group => {
            infer_group_type_deep(source, span, locals, consts, fns)
        },
        ExprKind.Unary => {
            infer_unary_type_deep(source, span, locals, consts, fns)
        },
        _ => {
            ""
        },
    }
}

fn infer_expr_type_from_outline(source: Text, expr_span: OptionalSpan, expr_kind: ExprKind, locals: Text, consts: Text, fns: Text) -> Text {
    if not expr_span.present {
        ""
    } else {
        match expr_kind {
            ExprKind.Integer => { "I32" },
            ExprKind.Float => { "F64" },
            ExprKind.Bool => { "Bool" },
            ExprKind.String => { "Text" },
            ExprKind.Name => {
                let name_text_val = text_slice(source, expr_span.span.start, expr_span.span.end);
                infer_name_type(name_text_val, locals, consts, fns)
            },
            ExprKind.Call => {
                infer_call_ret_type(source, expr_span.span, fns)
            },
            _ => {
                infer_expr_type_deep(source, expr_span.span, expr_kind, locals, consts, fns)
            },
        }
    }
}

fn line_start_index(source: Text, pos: I32) -> I32 {
    if pos <= 0 {
        0
    } else {
        let mut start = 0;
        let mut search = pos;
        while search > 0 {
            search = search - 1;
            if text_byte(source, search) == 10 {
                start = search + 1;
                search = -1;
            };
        };
        start
    }
}

fn is_simple_name(text: Text) -> Bool {
    if is_empty(text) {
        false
    } else {
        let mut ok = true;
        let mut i = 0;
        while i < text_len(text) {
            let b = text_byte(text, i);
            let valid = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95;
            if not valid {
                ok = false;
                i = text_len(text);
            };
            i = i + 1;
        };
        ok
    }
}

fn format_type_diag(source: Text, span: Span, message: Text) -> Text {
    let line_start = line_start_index(source, span.start);
    let line_end = find_line_end(source, span.start);
    let line_text = text_slice(source, line_start, line_end);
    text_concat("error: ", text_concat(message, text_concat("\n  at >", text_concat(line_text, "\n"))))
}

fn format_type_diag_at(source: Text, span_start: I32, span_end: I32, message: Text) -> Text {
    let line_start = line_start_index(source, span_start);
    let line_end = find_line_end(source, span_start);
    let line_text = text_slice(source, line_start, line_end);
    text_concat("error: ", text_concat(message, text_concat("\n  at >", text_concat(line_text, "\n"))))
}

fn extract_param_types_from(source: Text, span: OptionalSpan) -> Text {
    if not span.present {
        ""
    } else {
        let raw = text_slice(source, span.span.start, span.span.end);
        let trimmed = trim_text(raw);
        if is_empty(trimmed) {
            ""
        } else {
            let open = find_byte_index(trimmed, 40, 0);
            let close = if open >= 0 { find_byte_index(trimmed, 41, open + 1) } else { -1 };
            if open >= 0 and close > open {
                let content = trim_text(text_slice(trimmed, open + 1, close));
                parse_params_from(content, 0)
            } else {
                ""
            }
        }
    }
}

fn parse_params_from(content: Text, index: I32) -> Text {
    if index >= text_len(content) {
        ""
    } else {
        let colon = find_byte_index(content, 58, index);
        if colon < 0 {
            ""
        } else {
            let name = trim_text(text_slice(content, index, colon));
            let comma = find_byte_index(content, 44, colon + 1);
            let type_end = if comma >= 0 { comma } else { text_len(content) };
            let type_text = trim_text(text_slice(content, colon + 1, type_end));
            let entry = text_concat(name, text_concat(":", type_text));
            let rest = if comma >= 0 {
                parse_params_from(content, comma + 1)
            } else {
                ""
            };
            if is_empty(rest) {
                entry
            } else {
                text_concat(entry, text_concat("\n", rest))
            }
        }
    }
}

fn infer_snippet_type(snippet: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let trimmed = trim_text(snippet);
    if is_empty(trimmed) {
        "Unit"
    } else {
        let parse_state = parse_state_new(trimmed);
        if parse_state.status == ParseStatus.Err or parse_state.cursor.kind == TokenKind.Eof {
            ""
        } else {
            let kind = classify_expr_kind(trimmed, parse_state);
            match kind {
                ExprKind.Integer => { "I32" },
                ExprKind.Float => { "F64" },
                ExprKind.Bool => { "Bool" },
                ExprKind.String => { "Text" },
                ExprKind.Name => {
                    let name_val = trim_text(trimmed);
                    infer_name_type(name_val, locals, consts, fns)
                },
                ExprKind.Call => {
                    let paren = find_byte_index(trimmed, 40, 0);
                    if paren > 0 {
                        let callee = trim_text(text_slice(trimmed, 0, paren));
                        let ret = type_table_lookup(fns, callee);
                        if is_empty(ret) {
                            if is_builtin_fn(callee) {
                                builtin_return_type(callee)
                            } else {
                                ""
                            }
                        } else {
                            ret
                        }
                    } else {
                        ""
                    }
                },
                ExprKind.Binary => {
                    let span = make_span(0, text_len(trimmed));
                    find_operator_in_expr(trimmed, span)
                },
                ExprKind.If => {
                    infer_if_type_from_text(trimmed, locals, consts, fns)
                },
                ExprKind.Record => {
                    let brace = find_byte_index(trimmed, 123, 0);
                    if brace > 0 {
                        trim_text(text_slice(trimmed, 0, brace))
                    } else {
                        ""
                    }
                },
                ExprKind.While => {
                    "Unit"
                },
                ExprKind.Repeat => {
                    "Unit"
                },
                ExprKind.Group => {
                    infer_group_type(trimmed, locals, consts, fns)
                },
                ExprKind.Match => {
                    let span = make_span(0, text_len(trimmed));
                    infer_match_type_deep(trimmed, span, locals, consts, fns)
                },
                _ => {
                    ""
                },
            }
        }
    }
}

fn infer_group_type(text: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let start = find_byte_index(text, 40, 0);
    if start >= 0 {
        let close = find_matching_close_raw(text, start);
        if close > start + 1 {
            let inner = text_slice(text, start + 1, close - 1);
            infer_snippet_type(inner, locals, consts, fns)
        } else {
            "Unit"
        }
    } else {
        ""
    }
}

fn infer_if_type_from_text(text: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let then_brace = find_byte_index(text, 123, 0);
    if then_brace < 0 {
        "Unit"
    } else {
        let then_close = find_matching_close_raw(text, then_brace);
        let else_pos = find_byte_index(text, 101, then_close);
        if else_pos < 0 {
            "Unit"
        } else {
            let after_else = else_pos + 4;
            if after_else < text_len(text) {
                let after_else_text = trim_text(text_slice(text, after_else, text_len(text)));
                infer_branch_type(after_else_text, locals, consts, fns)
            } else {
                "Unit"
            }
        }
    }
}



fn extract_block_body(block_text: Text) -> Text {
    let trimmed = trim_text(block_text);
    if is_empty(trimmed) {
        ""
    } else if text_byte(trimmed, 0) == 123 {
        let close = find_matching_close_raw(trimmed, 0);
        if close > 1 {
            text_slice(trimmed, 1, close - 1)
        } else {
            ""
        }
    } else {
        trimmed
    }
}

fn infer_branch_type(branch_text: Text, locals: Text, consts: Text, fns: Text) -> Text {
    let trimmed = trim_text(branch_text);
    if is_empty(trimmed) {
        "Unit"
    } else if text_byte(trimmed, 0) == 123 {
        let body = extract_block_body(branch_text);
        if is_empty(body) {
            "Unit"
        } else {
            infer_snippet_type(body, locals, consts, fns)
        }
    } else {
        infer_snippet_type(trimmed, locals, consts, fns)
    }
}

fn check_if_type_deep(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let then_brace = find_byte_index(expr_text, 123, 0);
    if then_brace < 0 {
        ""
    } else {
        let then_close = find_matching_close_raw(expr_text, then_brace);
        let then_body = text_slice(expr_text, then_brace + 1, then_close - 1);
        let then_type = infer_branch_type(then_body, locals, consts, fns);
        let else_pos = find_byte_index(expr_text, 101, then_close);
        if else_pos >= 0 and else_pos + 4 < text_len(expr_text) {
            let after_else = trim_text(text_slice(expr_text, else_pos + 4, text_len(expr_text)));
            if not is_empty(after_else) {
                let else_type = infer_branch_type(after_else, locals, consts, fns);
                if not is_empty(then_type) and not is_empty(else_type) and then_type != else_type {
                    if not (is_numeric_type(then_type) and is_numeric_type(else_type)) {
                        let msg = text_concat("if branches have different types: `", text_concat(then_type, text_concat("` and `", text_concat(else_type, "`"))));
                        format_type_diag(source, span, msg)
                    } else {
                        ""
                    }
                } else {
                    ""
                }
            } else {
                ""
            }
        } else {
            ""
        }
    }
}

fn check_unary_operator_args(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let trimmed = trim_text(expr_text);
    let len = text_len(trimmed);
    let mut i = 0;
    let mut op_end = -1;
    while i < len and op_end < 0 {
        let b = text_byte(trimmed, i);
        if b == 110 {
            if i + 3 < len and text_slice(trimmed, i, i + 4) == "not " {
                op_end = i + 4;
            } else {
                i = i + 1;
            };
        } else if b == 45 or b == 126 {
            op_end = i + 1;
        } else {
            i = i + 1;
        };
    };
    if op_end < 0 or op_end >= len {
        ""
    } else {
        let operand = trim_text(text_slice(trimmed, op_end, len));
        if is_empty(operand) {
            ""
        } else {
            let operand_type = infer_snippet_type(operand, locals, consts, fns);
            if is_empty(operand_type) {
                ""
            } else if text_byte(trimmed, 0) == 110 {
                if operand_type != "Bool" {
                    format_type_diag(source, span, text_concat("operand of `not` must be `Bool`, found `", text_concat(operand_type, "`")))
                } else {
                    ""
                }
            } else {
                ""
            }
        }
    }
}

fn check_expr_types_deep(source: Text, expr_span: OptionalSpan, expr_kind: ExprKind, locals: Text, consts: Text, fns: Text) -> Text {
    if expr_span.present {
        match expr_kind {
            ExprKind.If => {
                check_if_type_deep(source, expr_span.span, locals, consts, fns)
            },
            ExprKind.Binary => {
                check_binary_operator_args(source, expr_span.span, locals, consts, fns)
            },
            ExprKind.Match => {
                check_match_arm_types(source, expr_span.span, locals, consts, fns)
            },
            ExprKind.Unary => {
                check_unary_operator_args(source, expr_span.span, locals, consts, fns)
            },
            _ => {
                ""
            },
        }
    } else {
        ""
    }
}

fn check_fn_return_type(source: Text, state: ParseState, consts: Text, fns: Text, known: Text) -> Text {
    let parsed = parse_fn_item_with_shape(source, state);
    let shape = parsed.shape;
    let outline = shape.body_outline;
    let return_span = shape.return_span;
    let return_type_text = extract_type_text(span_text_safe(source, return_span));
let mut locals = extract_param_types_from(source, shape.params_span);
    let mut tail_type = "";
    let mut out = "";
    let mut index = 0;
    while index < 5 {
        let item = block_item_entry_at(outline, index);
        if item.present {
            let entry = item.entry;
            let entry_kind = entry.kind;
            let entry_binding = entry.binding_span;
            let entry_expr = entry.expr_span;
            let entry_expr_kind = entry.expr_kind;
            if entry_kind == BlockItemKind.Let {
                if entry_binding.present {
                    let binding_text_span = entry_binding.span;
                    let binding_start = binding_text_span.start;
                    let binding_end = binding_text_span.end;
                    let binding_name = text_slice(source, binding_start, binding_end);
                    let entry_expr_present = entry_expr.present;
                    let entry_expr_text_span = entry_expr.span;
                    let entry_expr_span_start = entry_expr_text_span.start;
                    let entry_expr_span_end = entry_expr_text_span.end;
                    if not is_empty(type_table_lookup(locals, binding_name)) {
                        let diag = format_type_diag_at(source, binding_start, binding_end, text_concat("duplicate local `", text_concat(binding_name, "`")));
                        out = if is_empty(out) { diag } else { text_concat(out, diag) };
                    } else {
                        if entry_expr_kind == ExprKind.Name and entry_expr_present {
                            let name_str = text_slice(source, entry_expr_span_start, entry_expr_span_end);
                            if is_simple_name(name_str) {
                                let is_known = not is_empty(type_table_lookup(locals, name_str))
                                    or not is_empty(type_table_lookup(consts, name_str))
                                    or not is_empty(type_table_lookup(fns, name_str))
                                    or not is_empty(type_table_lookup(known, name_str))
                                    or is_builtin_fn(name_str);
                                if not is_known {
                                    let diag = format_type_diag_at(source, entry_expr_span_start, entry_expr_span_end, text_concat("unknown name `", text_concat(name_str, "`")));
                                    out = if is_empty(out) { diag } else { text_concat(out, diag) };
                                };
                            };
                        };
            };
            let inferred = infer_expr_type_from_outline(source, entry_expr, entry_expr_kind, locals, consts, fns);
                    if not is_empty(inferred) {
                        let is_mutable = binding_start >= 5 and text_slice(source, binding_start - 4, binding_start) == "mut ";
                        let entry_type = if is_mutable { text_concat("mut:", inferred) } else { inferred };
                        locals = type_table_extend(locals, binding_name, entry_type);
                    };
                    let deep_diag = check_expr_types_deep(source, entry_expr, entry_expr_kind, locals, consts, fns);
                    if not is_empty(deep_diag) {
                        out = if is_empty(out) { deep_diag } else { text_concat(out, deep_diag) };
                    };
                };
            } else if entry_kind == BlockItemKind.Assign {
                if entry_binding.present {
                    let binding_span = entry_binding.span;
                    let binding_start = binding_span.start;
                    let binding_end = binding_span.end;
                    let binding_text = text_slice(source, binding_start, binding_end);
                    let has_index = find_byte_index(binding_text, 91, 0) >= 0;
                    if has_index {
                        let open_bracket = find_byte_index(binding_text, 91, 0);
                        let target_name = trim_text(text_slice(binding_text, 0, open_bracket));
                        if not is_empty(target_name) and is_simple_name(target_name) {
                            let target_type = type_table_lookup(locals, target_name);
                            if not is_empty(target_type) {
                                if not is_array_or_list_type(target_type) {
                                    let diag = format_type_diag_at(source, binding_start, binding_end, text_concat("cannot index into non-array type `", text_concat(target_type, "`")));
                                    out = if is_empty(out) { diag } else { text_concat(out, diag) };
                                };
                            } else {
                                let diag = format_type_diag_at(source, binding_start, binding_end, text_concat("unknown variable `", text_concat(target_name, "`")));
                                out = if is_empty(out) { diag } else { text_concat(out, diag) };
                            };
                        };
                    } else if is_simple_name(binding_text) {
                        let binding_type = type_table_lookup(locals, binding_text);
                        if is_empty(binding_type) {
                            let diag = format_type_diag_at(source, binding_start, binding_end, text_concat("unknown variable `", text_concat(binding_text, "`")));
                            out = if is_empty(out) { diag } else { text_concat(out, diag) };
                        } else if not text_starts_with_at(binding_type, "mut", 0) {
                            let diag = format_type_diag_at(source, binding_start, binding_end, text_concat("cannot assign to immutable variable `", binding_text));
                            out = if is_empty(out) { diag } else { text_concat(out, diag) };
                        };
                    };
                };
                let deep_diag = check_expr_types_deep(source, entry_expr, entry_expr_kind, locals, consts, fns);
                if not is_empty(deep_diag) {
                    out = if is_empty(out) { deep_diag } else { text_concat(out, deep_diag) };
                };
            } else if entry_kind == BlockItemKind.TailExpr {
                let entry_expr_present = entry_expr.present;
                let entry_expr_text_span = entry_expr.span;
                let entry_expr_span_start = entry_expr_text_span.start;
                let entry_expr_span_end = entry_expr_text_span.end;
                if entry_expr_kind == ExprKind.Name and entry_expr_present {
                    let name_str = text_slice(source, entry_expr_span_start, entry_expr_span_end);
                    if is_simple_name(name_str) {
                        let is_known = not is_empty(type_table_lookup(locals, name_str))
                            or not is_empty(type_table_lookup(consts, name_str))
                            or not is_empty(type_table_lookup(fns, name_str))
                            or not is_empty(type_table_lookup(known, name_str))
                            or is_builtin_fn(name_str);
                        if not is_known {
                            let diag = format_type_diag_at(source, entry_expr_span_start, entry_expr_span_end, text_concat("unknown name `", text_concat(name_str, "`")));
                            out = if is_empty(out) { diag } else { text_concat(out, diag) };
                        };
                    };
                };
                tail_type = infer_expr_type_from_outline(source, entry_expr, entry_expr_kind, locals, consts, fns);
                let deep_diag = check_expr_types_deep(source, entry_expr, entry_expr_kind, locals, consts, fns);
                if not is_empty(deep_diag) {
                    out = if is_empty(out) { deep_diag } else { text_concat(out, deep_diag) };
                };
            };
        };
        index = index + 1;
    };
    let return_diag = if is_empty(return_type_text) {
        if is_empty(tail_type) {
            ""
        } else {
            if tail_type == "Unit" {
                ""
            } else {
                format_type_diag(source, shape.body_span.span, text_concat("tail expression type `", text_concat(tail_type, text_concat("` does not match implicit Unit return type", ""))))
            }
        }
    } else {
        if is_empty(tail_type) {
            ""
        } else {
            if return_type_text == tail_type or (is_numeric_type(return_type_text) and is_numeric_type(tail_type)) {
                ""
            } else {
                format_type_diag(source, shape.body_span.span, text_concat("expected return type `", text_concat(return_type_text, text_concat("` but tail expression has type `", text_concat(tail_type, "`")))))
            }
        }
    };
    if is_empty(out) {
        return_diag
    } else {
        if is_empty(return_diag) {
            out
        } else {
            text_concat(out, return_diag)
        }
    }
}

fn is_affine_type(ty: Text) -> Bool {
    let stripped = strip_mut_prefix(ty);
    stripped == "Text" or stripped == "Bytes" or stripped == "File" or stripped == "TextBuilder" or stripped == "TextIndex" or text_starts_with_at(stripped, "List", 0)
}

fn is_array_or_list_type(ty: Text) -> Bool {
    let stripped = strip_mut_prefix(ty);
    text_starts_with_at(stripped, "[", 0) or stripped == "List"
}

fn strip_mut_prefix(ty: Text) -> Text {
    if text_starts_with_at(ty, "mut:", 0) {
        text_slice(ty, 4, text_len(ty))
    } else {
        ty
    }
}

fn is_comparison_operator(expr_text: Text) -> Bool {
    let eq_found = find_byte_index(expr_text, 61, 0) >= 0;
    let bang_found = find_byte_index(expr_text, 33, 0) >= 0;
    let lt_found = find_byte_index(expr_text, 60, 0) >= 0;
    let gt_found = find_byte_index(expr_text, 62, 0) >= 0;
    eq_found or bang_found or lt_found or gt_found
}

fn is_chain_operator(expr_text: Text) -> Bool {
    let has_and = find_operator_index(expr_text, " and ", 0) >= 0;
    let has_or = find_operator_index(expr_text, " or ", 0) >= 0;
    has_and or has_or
}

fn check_binary_operator_args(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let len = text_len(expr_text);
    let mut op_pos = -1;
    let mut op_width = 0;
    let mut i = 0;
    while i < len and op_pos < 0 {
        let b = text_byte(expr_text, i);
        if b == 61 or b == 33 or b == 60 or b == 62 or b == 43 or b == 45 or b == 42 or b == 47 or b == 37 or b == 97 or b == 111 {
            if b == 97 {
                if i + 4 < len and text_slice(expr_text, i, i + 5) == " and " {
                    op_pos = i;
                    op_width = 5;
                };
            } else if b == 111 {
                if i + 3 < len and text_slice(expr_text, i, i + 4) == " or " {
                    op_pos = i;
                    op_width = 4;
                };
            } else if b == 61 or b == 33 {
                if i + 1 < len and text_byte(expr_text, i + 1) == 61 {
                    op_pos = i;
                    op_width = 2;
                };
            } else if b == 60 or b == 62 {
                if i > 0 and is_layout_byte(text_byte(expr_text, i - 1)) {
                    if i + 1 < len and text_byte(expr_text, i + 1) == 61 {
                        op_pos = i;
                        op_width = 2;
                    } else {
                        op_pos = i;
                        op_width = 1;
                    };
                };
            } else {
                if i > 0 and (b == 43 or b == 45 or b == 42 or b == 47 or b == 37) and is_layout_byte(text_byte(expr_text, i - 1)) {
                    op_pos = i;
                    op_width = 1;
                };
            };
        };
        i = i + 1;
    };
    if op_pos < 0 {
        ""
    } else {
        let left_str = trim_text(text_slice(expr_text, 0, op_pos));
        let right_start = op_pos + op_width;
        let right_str = trim_text(text_slice(expr_text, right_start, len));
        if is_empty(left_str) or is_empty(right_str) {
            ""
        } else {
            let left_type = infer_snippet_type(left_str, locals, consts, fns);
            let right_type = infer_snippet_type(right_str, locals, consts, fns);
            if is_empty(left_type) or is_empty(right_type) {
                ""
            } else if is_chain_operator(expr_text) {
                if left_type != "Bool" {
                    format_type_diag(source, span, text_concat("left operand of `", text_concat(expr_text, text_concat("` must be `Bool`, found `", text_concat(left_type, "`")))))
                } else if right_type != "Bool" {
                    format_type_diag(source, span, text_concat("right operand of `", text_concat(expr_text, text_concat("` must be `Bool`, found `", text_concat(right_type, "`")))))
                } else {
                    ""
                }
            } else if is_comparison_operator(expr_text) {
                if left_type != right_type {
                    if is_numeric_type(left_type) and is_numeric_type(right_type) {
                        ""
                    } else {
                        format_type_diag(source, span, text_concat("binary operator requires same types, got `", text_concat(left_type, text_concat("` and `", text_concat(right_type, "`")))))
                    }
                } else {
                    ""
                }
            } else if find_byte_index(expr_text, 43, 0) >= 0 {
                if left_type == "Text" and right_type == "Text" {
                    ""
                } else if is_numeric_type(left_type) and is_numeric_type(right_type) {
                    ""
                } else {
                    format_type_diag(source, span, text_concat("`+` requires Text or numeric operands, got `", text_concat(left_type, text_concat("` and `", text_concat(right_type, "`")))))
                }
            } else {
                if is_numeric_type(left_type) and is_numeric_type(right_type) {
                    ""
                } else {
                    format_type_diag(source, span, text_concat("arithmetic operator requires numeric operands, got `", text_concat(left_type, text_concat("` and `", text_concat(right_type, "`")))))
                }
            }
        }
    }
}

fn check_match_arm_types(source: Text, span: Span, locals: Text, consts: Text, fns: Text) -> Text {
    let expr_text = text_slice(source, span.start, span.end);
    let brace = find_byte_index(expr_text, 123, 0);
    if brace < 0 {
        ""
    } else {
        let close = find_matching_close_raw(expr_text, brace);
        if close <= brace + 1 {
            ""
        } else {
            let body = text_slice(expr_text, brace + 1, close - 1);
            let mut arm_types = "";
            let mut body_i = 0;
            let body_len = text_len(body);
            let mut arm_idx = 0;
            while body_i < body_len {
                let arrow = find_byte_index(body, 61, body_i);
                if arrow < 0 or arrow + 1 >= body_len or not (text_byte(body, arrow + 1) == 62) {
                    body_i = body_len;
                } else {
                    let after_arrow = arrow + 2;
                    let arm_start = trim_start_index(body, after_arrow);
                    let arm_end = if arm_start < body_len and text_byte(body, arm_start) == 123 {
                        find_matching_close_raw(body, arm_start)
                    } else {
                        let comma = find_byte_index(body, 44, arm_start);
                        if comma >= 0 { comma } else { body_len }
                    };
                    let arm_expr = trim_text(text_slice(body, arm_start, arm_end));
                    if not is_empty(arm_expr) {
                        let arm_type = infer_branch_type(arm_expr, locals, consts, fns);
                        if not is_empty(arm_type) {
                            arm_types = type_table_extend(arm_types, int_to_text(arm_idx), arm_type);
                            arm_idx = arm_idx + 1;
                        };
                    };
                    body_i = arm_end;
                    if body_i < body_len and text_byte(body, body_i) == 44 {
                        body_i = body_i + 1;
                    } else if body_i < body_len and text_byte(body, body_i) == 125 {
                        body_i = body_len;
                    } else if body_i < body_len {
                        let next_stop = find_byte_index(body, 44, body_i);
                        if next_stop >= 0 {
                            body_i = next_stop + 1;
                        } else {
                            body_i = body_len;
                        };
                    };
                };
            };
            if arm_idx <= 1 {
                ""
            } else {
                let first_type = type_table_lookup(arm_types, "0");
                if is_empty(first_type) {
                    ""
                } else {
                    let mut mismatch = "";
                    let mut check_i = 1;
                    while check_i < arm_idx {
                        let key = int_to_text(check_i);
                        let arm_type = type_table_lookup(arm_types, key);
                        if not is_empty(arm_type) {
                            if arm_type != first_type and not (is_numeric_type(arm_type) and is_numeric_type(first_type)) {
                                mismatch = format_type_diag(source, span, text_concat("match arms have inconsistent types: `", text_concat(first_type, text_concat("` and `", text_concat(arm_type, "`")))));
                            };
                        };
                        check_i = check_i + 1;
                    };
                    mismatch
                }
            }
        }
    }
}

fn check_const_type(source: Text, state: ParseState, consts: Text, fns: Text, known: Text) -> Text {
    let name_span = top_level_name_span(source, state);
    if name_span.present {
        let nspan = name_span.span;
        let nend = nspan.end;
        let cname = text_slice(source, nspan.start, nend);
        if not is_empty(cname) {
            let colon_idx = find_byte_index(source, 58, nend);
            let semi_idx = find_byte_index(source, 59, nend);
            if colon_idx >= 0 and semi_idx >= 0 and colon_idx < semi_idx {
                let eq_idx = find_byte_index(source, 61, colon_idx);
                if eq_idx >= 0 and eq_idx < semi_idx {
                    let declared_type = trim_text(text_slice(source, colon_idx + 1, eq_idx));
                    let expr_start = trim_start_index(source, eq_idx + 1);
                    let expr_end = trim_end_index(source, semi_idx);
                    if expr_end > expr_start {
                        let expr_text = text_slice(source, expr_start, expr_end);
                        let expr_state = parse_state_new(expr_text);
                        let expr_kind = classify_expr_kind(expr_text, expr_state);
                        let expr_span = OptionalSpan { present: true, span: Span { start: expr_start, end: expr_end } };
                        let mut out = "";
                        if expr_kind == ExprKind.Name {
                            let name_str = text_slice(source, expr_start, expr_end);
                            if is_simple_name(name_str) {
                                let is_known = not is_empty(type_table_lookup(consts, name_str))
                                    or not is_empty(type_table_lookup(fns, name_str))
                                    or not is_empty(type_table_lookup(known, name_str))
                                    or is_builtin_fn(name_str);
                                if not is_known {
                                    out = format_type_diag(source, Span { start: expr_start, end: expr_end }, text_concat("unknown name `", text_concat(name_str, "`")));
                                };
                            };
                        };
                        if not is_empty(declared_type) {
                            let inferred = infer_expr_type_from_outline(source, expr_span, expr_kind, "", consts, fns);
                            if not is_empty(inferred) {
                                if declared_type != inferred and not (is_numeric_type(declared_type) and is_numeric_type(inferred)) {
                                    let msg = text_concat("expected const type `", text_concat(declared_type, text_concat("` but initializer has type `", text_concat(inferred, "`"))));
                                    let diag = format_type_diag(source, Span { start: expr_start, end: expr_end }, msg);
                                    out = if is_empty(out) { diag } else { text_concat(out, diag) };
                                };
                            };
                        };
                        out
                    } else {
                        ""
                    }
                } else {
                    ""
                }
            } else {
                ""
            }
        } else {
            ""
        }
    } else {
        ""
    }
}

fn check_const_types_from(source: Text, state: ParseState, consts: Text, fns: Text, known: Text) -> Text {
    let mut cur_state = state;
    let mut out = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwConst {
            let diag = check_const_type(source, cur_state, consts, fns, known);
            cur_state = parse_const_item(source, cur_state);
            if not is_empty(diag) {
                out = if is_empty(out) { diag } else { text_concat(out, diag) };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_fn_item(source, cur_state)
            };
        };
    };
    out
}

fn check_fn_types_from(source: Text, state: ParseState, consts: Text, fns: Text, known: Text) -> Text {
    let mut cur_state = state;
    let mut out = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwFn {
            let diag = check_fn_return_type(source, cur_state, consts, fns, known);
            let parsed = parse_fn_item_with_shape(source, cur_state);
            cur_state = parsed.state;
            if not is_empty(diag) {
                out = if is_empty(out) { diag } else { text_concat(out, diag) };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_const_item(source, cur_state)
            };
        };
    };
    out
}

fn collect_const_types(source: Text, state: ParseState) -> Text {
    let mut cur_state = state;
    let mut types = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwConst {
            let name_span = top_level_name_span(source, cur_state);
            let parsed = parse_const_item(source, cur_state);
            cur_state = parsed;
            if name_span.present {
                let nspan = name_span.span;
                let nend = nspan.end;
                let cname = text_slice(source, nspan.start, nend);
                if not is_empty(cname) {
                    let colon_idx = find_byte_index(source, 58, nend);
                    let semi_idx = find_byte_index(source, 59, nend);
                    if colon_idx >= 0 and semi_idx >= 0 and colon_idx < semi_idx {
                        let eq_idx = find_byte_index(source, 61, colon_idx);
                        if eq_idx >= 0 and eq_idx < semi_idx {
                            let type_text_v = trim_text(text_slice(source, colon_idx + 1, eq_idx));
                            if not is_empty(type_text_v) {
                                types = type_table_extend(types, cname, type_text_v);
                            };
                        };
                    };
                };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_fn_item(source, cur_state)
            };
        };
    };
    types
}

fn collect_fn_sigs_from(source: Text, state: ParseState) -> Text {
    let mut cur_state = state;
    let mut sigs = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwFn {
            let name_span = top_level_name_span(source, cur_state);
            let parsed = parse_fn_item_with_shape(source, cur_state);
            cur_state = parsed.state;
            if name_span.present {
                let fn_name = text_slice(source, name_span.span.start, name_span.span.end);
                if not is_empty(fn_name) {
                    let ret_text = extract_type_text(span_text_safe(source, parsed.shape.return_span));
                    if is_empty(ret_text) {
                        sigs = type_table_extend(sigs, fn_name, "Unit");
                    } else {
                        sigs = type_table_extend(sigs, fn_name, ret_text);
                    };
                };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_const_item(source, cur_state)
            };
        };
    };
    sigs
}

fn check_text(source: Text, package_names: Text) -> Text {
    let report = parse_module_report(source);
    if not report.ok {
        report.diagnostics
    } else {
        let mut state = parse_state_new(source);
        let mut all_names = "";
        let mut seen = "";
        let mut dup_diag = "";
        while state.status == ParseStatus.Ok and state.cursor.kind != TokenKind.Eof {
            let name_span = top_level_name_span(source, state);
            state = if state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, state)
            } else if state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, state)
            } else if state.cursor.kind == TokenKind.KwConst {
                parse_const_item(source, state)
            } else {
                parse_fn_item(source, state)
            };
            if name_span.present {
                let name = text_slice(source, name_span.span.start, name_span.span.end);
                if not is_empty(name) and name != "_" {
                    all_names = name_table_add(all_names, name);
                    if name_table_has(seen, name) {
                        let diag = text_concat("error: duplicate definition `", text_concat(name, "`\n"));
                        dup_diag = if is_empty(dup_diag) { diag } else { text_concat(dup_diag, diag) };
                    } else {
                        seen = name_table_add(seen, name);
                    };
                };
            };
        };
        let known = if is_empty(package_names) {
            all_names
        } else {
            text_concat(all_names, text_concat("\n", package_names))
        };
        let call_diag = check_body_calls_from(source, parse_state_new(source), known);
        
        let struct_types = collect_struct_types(source, parse_state_new(source));
        let base_const_types = collect_const_types(source, parse_state_new(source));
        let const_types = if is_empty(struct_types) {
            base_const_types
        } else if is_empty(base_const_types) {
            struct_types
        } else {
            text_concat(base_const_types, text_concat("\n", struct_types))
        };
        let fn_sigs = collect_fn_sigs_from(source, parse_state_new(source));
        let const_type_diag = check_const_types_from(source, parse_state_new(source), const_types, fn_sigs, known);
        let fn_type_diag = check_fn_types_from(source, parse_state_new(source), const_types, fn_sigs, known);
        let ownership_diag = check_ownership_from(source, parse_state_new(source));
        
        let combined = text_concat(dup_diag, text_concat(call_diag, text_concat(const_type_diag, text_concat(fn_type_diag, ownership_diag))));
        if is_empty(combined) {
            "ok [core]\n"
        } else {
            combined
        }
    }
}

fn is_affine_ownership_type(ty: Text) -> Bool {
    let tlen = text_len(ty);
    if tlen == 4 and text_byte(ty, 0) == 84 {
        true
    } else if tlen == 5 and text_byte(ty, 0) == 66 {
        true
    } else if tlen == 11 and text_byte(ty, 0) == 84 {
        true
    } else if tlen == 9 and text_byte(ty, 0) == 84 {
        true
    } else if tlen == 4 and text_byte(ty, 0) == 70 {
        true
    } else {
        false
    }
}

fn count_affine_param_uses_in_body(source: Text, param_name: Text, body_start: I32, body_end: I32) -> I32 {
    let pnlen = text_len(param_name);
    let mut count = 0;
    let mut pos = body_start;
    while pos + pnlen <= body_end {
        if text_eq_range(source, pos, pos + pnlen, param_name) {
            let before_ok = pos == body_start or not is_name_byte(text_byte(source, pos - 1));
            let after_ok = pos + pnlen >= body_end or not is_name_byte(text_byte(source, pos + pnlen));
            if before_ok and after_ok {
                count = count + 1;
            };
        };
        pos = pos + 1;
    };
    count
}

fn is_name_byte(b: I32) -> Bool {
    (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95
}

fn find_open_paren_before(source: Text, before_pos: I32) -> I32 {
    let mut pos = before_pos - 1;
    let mut found = -1;
    while pos >= 0 and found < 0 {
        if text_byte(source, pos) == 40 {
            found = pos;
        };
        pos = pos - 1;
    };
    found
}

fn extract_params_text(source: Text, fn_name_end: I32, body_start: I32) -> Text {
    let open_paren = find_open_paren_before(source, body_start);
    if open_paren >= 0 and open_paren > fn_name_end {
        let close_paren = find_matching_close_raw(source, open_paren);
        if close_paren >= 0 and close_paren < body_start and close_paren > open_paren + 1 {
            trim_text(text_slice(source, open_paren + 1, close_paren))
        } else {
            ""
        }
    } else {
        ""
    }
}

fn check_fn_ownership(source: Text, fn_name_start: I32, fn_name_end: I32, body_start: I32, body_end: I32) -> Text {
    let fn_name = text_slice(source, fn_name_start, fn_name_end);
    
    let params_trimmed = extract_params_text(source, fn_name_end, body_start);
    if is_empty(params_trimmed) {
        ""
    } else {
        let mut diags = "";
        let mut pi = 0;
        let plen = text_len(params_trimmed);
        while pi < plen {
            let colon = find_byte_index(params_trimmed, 58, pi);
            if colon < 0 {
                pi = plen;
            } else {
                let comma = find_byte_index(params_trimmed, 44, colon + 1);
                let param_end = if comma >= 0 { comma } else { plen };
                let pname = trim_text(text_slice(params_trimmed, pi, colon));
                let ptype = trim_text(text_slice(params_trimmed, colon + 1, param_end));
                if not is_empty(pname) and is_affine_ownership_type(ptype) {
                    let count = count_affine_param_uses_in_body(source, pname, body_start, body_end);
                    if count > 1 {
                        let msg = text_concat("affine value `", text_concat(pname, text_concat("` used ", text_concat(int_to_text(count), text_concat(" times in `", text_concat(fn_name, "`\n"))))));
                        diags = if is_empty(diags) { msg } else { text_concat(diags, msg) };
                    };
                };
                pi = if comma >= 0 { comma + 1 } else { plen };
            };
        };
        diags
    }
}

fn check_ownership_from(source: Text, state: ParseState) -> Text {
    let mut cur_state = state;
    let mut out = "";
    while cur_state.status == ParseStatus.Ok and cur_state.cursor.kind != TokenKind.Eof {
        if cur_state.cursor.kind == TokenKind.KwFn {
            let name_span = top_level_name_span(source, cur_state);
            let parsed = parse_fn_item_with_shape(source, cur_state);
            cur_state = parsed.state;
            if name_span.present and parsed.shape.body_span.present {
                let fn_name_start = name_span.span.start;
                let fn_name_end = name_span.span.end;
                let body_span = parsed.shape.body_span.span;
                let body_start = body_span.start;
                let body_end = body_span.end;
                let diag = check_fn_ownership(source, fn_name_start, fn_name_end, body_start, body_end);
                if not is_empty(diag) {
                    out = if is_empty(out) { diag } else { text_concat(out, diag) };
                };
            };
        } else {
            cur_state = if cur_state.cursor.kind == TokenKind.KwStruct {
                parse_struct_item(source, cur_state)
            } else if cur_state.cursor.kind == TokenKind.KwEnum {
                parse_enum_item(source, cur_state)
            } else {
                parse_const_item(source, cur_state)
            };
        };
    };
    out
}

fn bool_score(value: Bool) -> I32 {
    if value {
        1
    } else {
        0
    }
}

fn main() -> I32 {
    let mut total = 0;
    total = total + bool_score(format_text("") == "\n");
    total = total + bool_score(format_text("fn main() -> I32 { 0 }") == "fn main() -> I32 {\n    0\n}\n");
    total = total + bool_score(format_text("fn main() -> I32 { 0 }\n") == "fn main() -> I32 {\n    0\n}\n");
    total = total + bool_score(format_text("fn main() -> I32 {\n    let mut total = 0;\n    if true {\n        total = total + 2;\n    };\n    total\n}\n") == "fn main() -> I32 {\n    let mut total = 0;\n    if true {\n        total = total + 2;\n    };\n    total\n}\n");
    total = total + bool_score(format_text("struct Pair {}\nfn main() {}") == "struct Pair {}\n\nfn main() {\n}\n");
    total = total + bool_score(text_slice("sarif", 1, 4) == "ari");
    total = total + bool_score(text_slice("sarif", 3, 99) == "if");
    total = total + bool_score(text_slice("sarif", 4, 2) == "");
    total
}
